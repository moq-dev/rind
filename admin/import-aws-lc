def preprocess(path, defines):
    # The headers only define what the defines already do, or macros for
    # other architectures.
    include = re.compile(r"#\s*include <openssl/")
    with open(path) as f:
        text = "".join(line for line in f if not include.match(line))
    # As an assembler source, so qhasm's `#` comment lines pass through.
    cpp = ["cpp", "-x", "assembler-with-cpp", "-traditional-cpp", "-P", "-undef", "-nostdinc"]
    cpp += [*defines, "-"]
    out = subprocess.run(cpp, input=text, capture_output=True, text=True, check=True)
    return out.stdout.splitlines()


def find(lines, words, start=0):
    for i in range(start, len(lines)):
        if lines[i].split() == words:
            return i
    sys.exit(f"missing line: {' '.join(words)}")


def constant(lines, label, following):
    """`label`'s line and the `following` lines, after any `.align` before it."""
    for i, line in enumerate(lines):
        if line.startswith(label):
            if lines[i - 1].split()[:1] == [".align"]:
                i -= 1
                following += 1
            return lines[i : i + 1 + following]
    sys.exit(f"missing constant: {label}")


def routine(lines, name):
    """`name` from its `.globl` through its `.size`."""
    start = find(lines, [".globl", name])
    end = find(lines, [".size", f"{name},.-{name}"], start)
    return lines[start : end + 1]


def body(lines, label, local, inner=()):
    """What follows `label` up to the next directive or label that ends a
    routine: Apple's flavor has no `.size`, so the next routine's label ends
    one there. Labels with the `local` prefix, or in `inner`, do not."""
    start = find(lines, [label]) + 1
    end = start
    while end < len(lines):
        words = lines[end].split()
        if words[:1] in ([".size"], [".section"], [".text"], [".globl"]):
            break
        if words and words[0].endswith(":") and not words[0].startswith(local) and words[0][:-1] not in inner:
            break
        end += 1
    # What separates it from the next routine: blank lines, comments, and
    # the next routine's alignment.
    while lines[end - 1].split()[:1] in ([], [".align"]) or lines[end - 1].lstrip().startswith(("//", "#")):
        end -= 1
    return lines[start:end]


def table(lines, label, local):
    """The values from `label` up to the first line that is not one of the
    same width, their width in bytes, and the offset of each label within
    them, keyed without `local`. A label just before a change of width starts
    the next table, which a spec names separately."""
    start = find(lines, [label]) + 1
    widths = {".quad": 8, ".long": 4, ".byte": 1}
    values, width, offsets = [], None, {}
    for line in lines[start:]:
        words = re.sub(r"(//|#).*", "", line).replace(",", " ").split()
        if not words:
            continue
        if len(words) == 1 and words[0].startswith(local) and words[0].endswith(":"):
            offsets[words[0][len(local) : -1]] = len(values) * width if width else 0
            continue
        if words[0] not in widths or width not in (None, widths[words[0]]):
            break
        width = widths[words[0]]
        values += words[1:]
    if not values:
        sys.exit(f"empty table: {label}")
    end = len(values) * width
    return values, width, {sub: offset for sub, offset in offsets.items() if offset < end}


def words(names):
    """Matches any of `names` as a whole symbol."""
    return re.compile(r"(?<![\w.$])(" + "|".join(map(re.escape, names)) + r")(?![\w$])")


def escape(lines, operands, local, tag, comment):
    """Doubles braces, writes each key of `operands`, an `(operand, offset)`,
    as `{operand}` plus any offset after its page modifier outside `comment`s,
    and tags each label `lines` defines with the `local` prefix."""
    lines = list(lines)
    defined = re.compile(re.escape(local) + r"[\w$]+(?=:)")
    labels = [m[0] for m in map(defined.match, lines) if m]
    operands_re = re.compile(words(operands).pattern + r"(@PAGE(?:OFF)?)?") if operands else None

    def operand(m):
        name, offset = operands[m[1]]
        return "{" + name + "}" + (m[2] or "") + (f"+{offset}" if offset else "")

    labels_re = words(labels) if labels else None
    for line in lines:
        code, leader, text = line.replace("{", "{{").replace("}", "}}").partition(comment)
        if operands_re:
            code = operands_re.sub(operand, code)
        line = code + leader + text
        if labels_re:
            line = labels_re.sub(lambda m: local + tag + "_" + m[1][len(local) :], line)
        yield line


def header(comment, spec, source):
    notice = spec.get("notice", [spec.get("copyright"), "SPDX-License-Identifier: Apache-2.0"])
    origin = f"{comment} {source}"
    if "perlasm" in spec:
        origin += f", which aws-lc generates from {spec['perlasm']}"
    return [f"{comment} {line}" for line in notice] + [
        f"{comment}",
        f"{comment} Generated by admin/import-aws-lc from aws-lc {REV}:",
        origin + ".",
        f"{comment} Do not edit by hand.",
    ]


def write(path, lines):
    with open(path, "w") as f:
        f.write("\n".join(lines) + "\n")


def import_arm(aws_lc):
    out_dir = os.path.join(ROOT, "arm", "aws_lc")
    for spec in ARM_IMPORTS:
        directory = spec.get("dir", "generated-src/linux-arm/crypto/fipsmodule")
        source = os.path.join(directory, spec["source"])
        lines = preprocess(os.path.join(aws_lc, source), ARM_CPP)

        if spec.get("whole"):
            text = "\n".join(lines).strip("\n").split("\n")
        else:
            text = []
            for label, following in spec["constants"]:
                text += constant(lines, label, following)
            for name in spec["routines"]:
                text += routine(lines, name)

        out = os.path.join(out_dir, spec["source"].removesuffix(".S") + ".s")
        operands = {name: (name, 0) for name in spec["routines"]}
        local = spec.get("local", ".L")
        write(out, header("@", spec, source) + list(escape(text, operands, local, spec["tag"], "@")))


def import_64(aws_lc):
    for spec in IMPORTS_64:
        arch = ARCHES[spec["arch"]]
        out_dir = os.path.join(ROOT, spec["arch"], "aws_lc")
        stem = spec["source"].removesuffix(".S")
        for flavor, (directory, defines, prefix, local) in arch["flavors"].items():
            source = os.path.join("generated-src", directory, "crypto", spec.get("dir", "fipsmodule"), spec["source"])
            lines = preprocess(os.path.join(aws_lc, source), arch["cpp"] + defines + spec.get("cpp", []))

            # A flavor names a table with or without its local prefix, and a
            # label inside it by the table's operand plus its offset.
            operands = {}
            for name in spec["tables"]:
                label = next(s for s in (name, local + name) if [s + ":"] in map(str.split, lines))
                values, width, offsets = table(lines, label + ":", local)
                operand = name.lstrip("_")
                operands |= {s: (operand, 0) for s in (name, local + name)}
                operands |= {local + sub: (operand, offset) for sub, offset in offsets.items()}
                if flavor == "linux":
                    per_row = 16 // width
                    rows = [f"    {', '.join(values[i : i + per_row])}," for i in range(0, len(values), per_row)]
                    rs = os.path.join(out_dir, f"{stem}.{operand}.rs")
                    write(rs, header("//", spec, source) + ["["] + rows + ["]"])

            helpers = spec.get("helpers", [])
            operands |= {name: (name.lstrip("_"), 0) for name in helpers}
            # Routines of another import that these call.
            operands |= {prefix + name: (name, 0) for name in spec.get("calls", [])}
            entries = [(f"{prefix}{name}:", name) for name in spec["routines"]]
            entries += [(f"{name}:", name.lstrip("_")) for name in helpers]
            inner = spec.get("inner", [])
            # A routine falls through these labels, which name helpers with
            # their own copy.
            dropped = [[f"{name}:"] for name in inner]
            carried = [line for name in spec.get("carries", []) for line in body(lines, f"{name}:", local)]
            joins = spec.get("joins", [])
            for name in joins:
                start = find(lines, [f"{name}:"])
                text = body(lines, f"{name}:", local)
                end = [line.split()[:1] for line in text].index([".cfi_endproc"])
                align = lines[start - 1 : start] if lines[start - 1].split()[:1] == [".align"] else []
                carried += align + [f"{local}{name}:"] + text[: end + 1]
            for label, name in entries:
                text = [line for line in body(lines, label, local, inner) if line.split() not in dropped]
                if name in spec["routines"]:
                    text += carried
                if joins:
                    text = [words(joins).sub(lambda m: local + m[1], line) for line in text]
                # Before the one instruction that names this symbol.
                for op, symbol, line in spec.get("inserts", {}).get(name, []):
                    at = [i for i, old in enumerate(text) if old.split() == [op, prefix + symbol]]
                    if len(at) != 1:
                        sys.exit(f"{name}: expected one {op} {symbol}")
                    text.insert(at[0], "\t" + line)
                directives = [line.split()[:1] for line in text]
                if label[:-1] in inner and [".cfi_endproc"] in directives and [".cfi_startproc"] not in directives:
                    text = [".cfi_startproc"] + text
                text = escape(text, operands, local, spec["tag"], arch["comment"])
                write(os.path.join(out_dir, f"{name}.{flavor}.s"), header(arch["comment"], spec, source) + list(text))


def main():
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    aws_lc = sys.argv[1]
    rev = subprocess.run(
        ["git", "-C", aws_lc, "rev-parse", "HEAD"], capture_output=True, text=True, check=True
    ).stdout.strip()
    if rev != REV:
        sys.exit(f"aws-lc is at {rev}, expected {REV}")

    import_arm(aws_lc)
    import_64(aws_lc)


if __name__ == "__main__":
    main()
