#!/usr/bin/env bash
# Runs cargo-mutants (see .cargo/mutants.toml) on this host's architecture,
# passing its arguments through. It skips generated assembly, which proofs and
# differential tests own, and every module only another architecture compiles,
# whose mutants no test here can reach.
#
# Off GitHub-hosted runners it mutates only a diff (`--in-diff`) or named
# files (`--file`): a whole campaign, over the workspace, a crate, or a
# backend, takes hours of every core, so it runs as a dispatch of
# .github/workflows/mutants.yml, which shards it across hosted runners.
# `--list` runs anywhere, and `--target TRIPLE` lists another
# architecture's campaign, such as `aarch64-unknown-linux-gnu`'s.
#
# Each test runs on this CPU and again with each row of features below denied,
# so code only CPUs without them run, such as aws-lc's SSE2 AES, is tested
# too. The rows are ctgrind.yml's.
#
# `admin/mutants --portable ...`, on x86_64 Linux, forces the portable backend
# with `--cfg rind_portable`, as `just portable` does, so the files only it
# and armv7 compile, and those armv7's assembly replaces, are mutated. It
# reads no CPU features, so it has no rows.
#
# No campaign runs armv7's own code or the AVX-512 paths: no runner takes
# them natively, and under qemu or Intel SDE a campaign took too long for
# what it found. The x86_64 campaign skips the files only AVX-512 runs, and
# .cargo/mutants.toml excludes the rest of both.
#
# cargo-mutants mutates code whatever its `cfg`, so a function only another
# architecture compiles is missed here. `admin/mutants --survivors DIR...`
# combines runs' `mutants.out` directories: it prints each mutant some run
# missed and none caught, and fails if there is one.
#
# `admin/mutants --pins` fails naming each `exclude_re` entry in
# .cargo/mutants.toml that matches no mutant, such as a `file:line` pin its
# code moved away from. cargo-mutants lists mutants whatever their `cfg`, so
# one listing covers every campaign.
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

if [ "${1:-}" = --pins ]; then
    cd "$here"
    # Without the config, so its exclusions don't hide what they match.
    cargo mutants --list --no-config | python3 -I -c '
import re, sys, tomllib
mutants = sys.stdin.read().splitlines()
with open(".cargo/mutants.toml", "rb") as f:
    patterns = tomllib.load(f)["exclude_re"]
stale = [p for p in patterns if not any(re.search(p, m) for m in mutants)]
for p in stale:
    print(f"admin/mutants: exclude_re matches no mutant: {p}", file=sys.stderr)
sys.exit(1 if stale else 0)
'
    exit
fi

portable_backend=
if [ "${1:-}" = --portable ]; then
    shift
    portable_backend=1
fi

if [ "${1:-}" = --survivors ]; then
    shift
    # A run with no mutants to test, such as one over an empty diff, writes
    # none of these. A file two backends include by `#[path]`, such as
    # `low/x86_64/../generic/aes_nohw.rs`, is named by its own path, so a
    # mutant one backend misses matches the other's catch.
    list() {
        for dir in "$@"; do
            for outcome in "${outcomes[@]}"; do
                [ ! -f "$dir/$outcome.txt" ] || cat "$dir/$outcome.txt"
            done
        done | sed 's#/[^/]*/\.\./#/#'
    }
    outcomes=(missed)
    missed=$(list "$@" | sort -u)
    outcomes=(caught timeout unviable)
    survivors=$(grep -vxF -f <(list "$@") <<<"$missed" || true)
    [ -z "$survivors" ] || {
        echo "$survivors"
        exit 1
    }
    exit 0
fi

target=
if [ "${1:-}" = --target ]; then
    target=$2
    shift 2
fi

# The options choosing what to mutate, ahead of the test arguments after `--`.
listing=
scoped=
package=
prev=
for arg in "$@"; do
    [ "$arg" != -- ] || break
    case $arg in
        --list | --list-files) listing=1 ;;
        --in-diff | --in-diff=* | -D | -D?* | --file | --file=* | -f | -f?*) scoped=1 ;;
        --package=*) package=${arg#--package=} ;;
        -p?*) package=${arg#-p} ;;
    esac
    case $prev in -p | --package) package=$arg ;; esac
    prev=$arg
done

case $(uname -sm) in
    "Linux x86_64") host=x86_64-unknown-linux-gnu ;;
    "Linux aarch64") host=aarch64-unknown-linux-gnu ;;
    "Darwin arm64") host=aarch64-apple-darwin ;;
    *) host="$(uname -sm)" ;;
esac

# Only armv7 and the portable backend compile these.
portable=(
    'rind/src/low/portable/**' 'rind/src/mid/portable/**'
    rind/src/low/generic/order.rs
)
# Darwin runs only the DIT code, which compiles for Apple's platforms alone;
# the Linux runs cover the rest.
only=()
campaign=${target:-$host}
if [ -n "$portable_backend" ]; then
    [ -z "$target" ] && [ "$campaign" = x86_64-unknown-linux-gnu ] || {
        echo "admin/mutants: --portable runs only on Linux x86_64, without --target" >&2
        exit 1
    }
    campaign=portable
fi
case $campaign in
    aarch64-apple-darwin)
        triple=AARCH64_APPLE_DARWIN
        skip=()
        only=(
            --file rind/src/low/cpu.rs --file rind/src/low/aarch64/cpu.rs
            --file rind/src/low/entry.rs
            --re '(\bDit\b|enter_cpu_state|leave_cpu_state|\bdit::|<impl Drop for Entry>::drop with \(\))'
        )
        rows=("dit")
        ;;
    x86_64-unknown-linux-gnu)
        triple=X86_64_UNKNOWN_LINUX_GNU
        skip=(
            'rind/src/low/aarch64/**' 'rind/src/low/arm/**' "${portable[@]}"
            rind/src/low/generic/mlkem_sample.rs
            rind/src/low/x86_64/mlkem_sample_poly_ntt_8x.rs
            rind/src/low/x86_64/rsaz_avx512.rs
        )
        rows=(
            "adx vaes"
            "adx avx intel sha"
            "adx avx intel sha aes pclmulqdq sse41"
            "adx ssse3"
        )
        ;;
    aarch64-unknown-linux-gnu)
        triple=AARCH64_UNKNOWN_LINUX_GNU
        skip=(
            'rind/src/low/x86_64/**' 'rind/src/low/arm/**' "${portable[@]}"
            rind/src/low/generic/mlkem_poly.rs
            rind/src/low/generic/sha1.rs rind/src/low/generic/sha256.rs
        )
        rows=(
            "sha3"
            "aes pmull sha2 sha3"
        )
        ;;
    portable)
        triple=X86_64_UNKNOWN_LINUX_GNU
        # The explicit target keeps these builds apart from the host's, and
        # RUSTFLAGS from its build scripts.
        export CARGO_BUILD_TARGET=x86_64-unknown-linux-gnu
        export RUSTFLAGS='--cfg rind_portable --cfg curve25519_dalek_backend="serial"'
        # The assembly backends, SHA-256 that only armv7 and x86_64's tests
        # compile, and the 32-bit limbs a 64-bit target doesn't, which the
        # x86_64 campaign's tests reach.
        skip=(
            'rind/src/low/x86_64/**' 'rind/src/low/aarch64/**' 'rind/src/low/arm/**'
            rind/src/low/generic/sha256.rs rind/src/low/generic/limb32.rs
            rind/src/low/generic/p256_mul32.rs rind/src/low/generic/p384_mul32.rs
        )
        rows=()
        ;;
    *)
        echo "admin/mutants: no campaign for $campaign" >&2
        exit 1
        ;;
esac
# The portable backend runs on the x86_64 host checked above; any other
# architecture's campaign only lists here.
[ "$campaign" = "$host" ] || [ -n "$portable_backend" ] || [ -n "$listing" ] || {
    echo "admin/mutants: $campaign's campaign runs only on its own architecture; here it only lists" >&2
    exit 1
}

# The test runner: runs one test binary on each row, failing if any fails.
# Nextest lists a binary's tests through the runner too, which needs one run.
# A crashing mutant fails its test either way, and its core dumps would
# pile up in the host's coredump store.
if [ "${1:-}" = --run ]; then
    shift
    ulimit -c 0
    "$@"
    for arg in "$@"; do
        [ "$arg" != --list ] || exit 0
    done
    # A row names features to deny.
    for row in ${rows[@]+"${rows[@]}"}; do
        deny=()
        for word in $row; do
            deny+=("RIND_CPU_DISABLE_$word=1")
        done
        env "${deny[@]}" "$@"
    done
    exit 0
fi

# A diff, named files, or a listing runs anywhere, as does the Darwin
# campaign, which names its files itself.
if [ -z "$listing$scoped" ] && [ ${#only[@]} -eq 0 ] && [ "${RUNNER_ENVIRONMENT:-}" != github-hosted ]; then
    name=${campaign%%-*}
    [ -z "$portable_backend" ] || name=portable
    branch=$(git -C "$here" branch --show-current)
    echo "admin/mutants: a whole campaign runs only on GitHub-hosted runners." >&2
    echo "Mutate a diff with --in-diff or files with --file here, or push the branch and dispatch it:" >&2
    echo "  gh workflow run mutants.yml --ref ${branch:-<branch>} -f campaign=$name${package:+ -f package=$package}" >&2
    exit 1
fi

cd "$here"
args=(${only[@]+"${only[@]}"})
for glob in ${skip[@]+"${skip[@]}"}; do
    args+=(--exclude "$glob")
done
while IFS= read -r file; do
    args+=(--exclude "$file")
done < <(git grep -l '^// generated source' -- rind/src)

# cargo-mutants' jobserver shares the CPUs between parallel jobs' builds, but
# not their tests: each job's nextest would run one test per CPU. Split the
# CPUs between the jobs' tests too.
jobs=${CARGO_MUTANTS_JOBS:-1}
prev=
for arg in "$@"; do
    [ "$arg" != -- ] || break
    case $prev in -j | --jobs) jobs=$arg ;; esac
    case $arg in -j?*) jobs=${arg#-j} ;; --jobs=*) jobs=${arg#--jobs=} ;; esac
    prev=$arg
done
export NEXTEST_TEST_THREADS=$((($(nproc) + jobs - 1) / jobs))

export "CARGO_TARGET_${triple}_RUNNER=$here/admin/mutants ${portable_backend:+--portable }${target:+--target $target }--run"
# A mutant that hangs the tests until the timeout is caught by them, so only
# exit 3, timeouts alone, passes beside 0.
status=0
cargo mutants "${args[@]}" "$@" || status=$?
[ "$status" -ne 3 ] || status=0
exit "$status"
