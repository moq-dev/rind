#!/usr/bin/env python3

# Usage: admin/ct-vartime [target...]
#
# The constant-time check for instructions whose timing depends on their
# operands, which ctgrind, `admin/ct-sde`, and `admin/ct-qemu` cannot see.
# It builds rind's release rlib for each Linux target in TARGETS, every
# architecture rind builds for, or those of them named, and disassembles it
# with every crate it links, the standard library and compiler-builtins included. Starting from
# every function named for rind, it follows each relocation, so calls, tail
# calls, and the function pointers in vtables, through to code the compiler
# generated. It fails if a function it reaches holds an instruction in
# VARTIME or calls a routine in HELPERS, unless `admin/ct-vartime.toml`
# lists exactly what that function holds on that target, with why its
# operands are public, or if an entry there does not match what is found.
#
# All of rind counts as a secret path, so no entry point needs marking, and
# a new instruction in a function the list names still fails. It stops at the panic routines
# in PANICS, which run only once a check has failed. It cannot see code that
# only rind's callers compile, such as a generic function at a type rind
# never instantiates itself, nor the C library's memcpy and memset.
#
# The build sets `--cfg rind_vartime_planted`, which adds the divisions of a
# secret in `rind/src/low/vartime_planted.rs`. Each must be found, so a scan
# that finds nothing fails.
#
# Run it in `nix develop .#ct-vartime`, which has llvm-objdump and each
# target's standard library.

import bisect, collections, concurrent.futures, json, multiprocessing, os, re, subprocess, sys, tomllib

TARGETS = [
    "x86_64-unknown-linux-gnu",
    "aarch64-unknown-linux-gnu",
    "armv7-unknown-linux-gnueabihf",
    # The portable backend every other architecture runs, forced as
    # `sh/dispatch.sh` forces it, at 64 and 32 bits.
    "x86_64-unknown-linux-gnu+portable",
    "armv7-unknown-linux-gnueabihf+portable",
    # The architectures whose only backend is the portable one. ARMv6 is
    # 32-bit ARM before ARMv7, and big-endian powerpc64 the ELFv1 ABI, whose
    # calls reach a function through its descriptor in `.opd`.
    "i686-unknown-linux-gnu",
    "arm-unknown-linux-gnueabihf",
    "loongarch64-unknown-linux-gnu",
    "powerpc-unknown-linux-gnu",
    "powerpc64-unknown-linux-gnu",
    "powerpc64le-unknown-linux-gnu",
    "riscv64gc-unknown-linux-gnu",
    "s390x-unknown-linux-gnu",
]
# Each target's VARTIME pattern, by the first part of its triple.
ARCH = {
    "x86_64": "x86", "i686": "x86", "armv7": "arm", "powerpc64": "powerpc",
    "powerpc64le": "powerpc", "riscv64gc": "riscv64",
}
PORTABLE = '--cfg rind_portable --cfg curve25519_dalek_backend="serial"'

# Instructions whose latency may depend on their operands: integer division,
# and floating-point arithmetic, whose subnormal operands take a slow path.
# Each is absent from its vendor's list of data-independent-time
# instructions:
# - Intel, "Data Operand Independent Timing Instructions", updated
#   2026-02-23, https://www.intel.com/content/www/us/en/developer/articles/technical/software-security-guidance/resources/data-operand-independent-timing-instructions.html
#   lists no DIV, IDIV, or floating-point arithmetic.
# - Arm, DDI 0601 2026-09, "DIT, Data Independent Timing",
#   https://developer.arm.com/documentation/ddi0601/2026-09/AArch64-Registers/DIT--Data-Independent-Timing
#   lists no UDIV, SDIV, or floating-point instruction but FCSEL. For
#   AArch32, DDI 0597 2026-09 marks no UDIV, SDIV, or VFP arithmetic
#   instruction data-independent-time.
# - RISC-V, "Zkt", Scalar Cryptography v1.0.1 section 31.6,
#   https://docs.riscv.org/reference/isa/v20240411/unpriv/scalar-crypto.html
#   lists multiplies, shifts, rotates, and carry-less multiplies, but
#   "division and remaindering excluded", and floating point "currently
#   excluded from the constant-time requirement".
# - Loongson, IBM for PowerPC and IBM Z, and Arm for ARMv6 publish no such
#   list, so their divisions and floating-point arithmetic count as
#   variable-time too.
# - BearSSL, "Constant-Time Implementations",
#   https://www.bearssl.org/constanttime.html: division "will trigger a
#   faster code path when the divisor and/or the dividend is small", as may
#   the compiler's routine where there is no divide instruction.
# BearSSL's https://www.bearssl.org/ctmul.html finds multiplication
# constant-time on x86_64 and Cortex-A, and Intel's, Arm's, and RISC-V's
# lists hold their multiplies, so none is listed. Nor are shifts by a
# variable count, which those lists hold too; BearSSL notes they are slow
# on the Pentium 4, which has no barrel shifter. The cores whose multiplier
# exits early, such as the PowerPC G3's and G4's and the T-Head C906's,
# need a masked multiply rind does not have, so the scan leaves them out
# and PLATFORMS.md names them, as it would gain nothing by refusing every
# multiply on every core of their architecture.
# x86 floating-point moves, shuffles, and bitwise operations take no slow
# path and are not listed; the other architectures' are told apart by name.
VARTIME = {
    # AAM, on 32-bit x86, divides AL by its operand.
    "x86": re.compile(
        r"i?div|aam"
        r"|v?(add|sub|mul|div|sqrt|min|max|hadd|hsub|addsub|dp|rcp|rsqrt|round)[sp][sdh]"
        r"|vfn?m(add|sub|addsub|subadd)\d*[sp][sdh]|v(rcp|rsqrt)(14|28)[sp][sdh]"
        r"|v(scalef|getexp|getmant|reduce|rndscale|range|fixupimm)[sp][sdh]|v?cvt\w+"
        r"|v?u?comis[sdh]|v?cmp\w*[ps][sdh]"
        # Every x87 mnemonic begins with `f`; all but these control and
        # state ones take floating-point operands.
        r"|f(?!(n?stcw|ldcw|n?stsw|n?clex|n?init|n?save|rstor|n?stenv|ldenv|x(save|rstor)(64)?|wait|emms|freep?|decstp|incstp|nop)$)\w+"
    ),
    # Every A64 floating-point mnemonic begins with `f`; of them, only FCSEL
    # is data-independent-time, and FMOV moves bits.
    "aarch64": re.compile(r"[us]divr?|[us]cvtf|f(?!(mov|csel)$)\w+"),
    # An A32 or T32 instruction may carry a condition, as in `udivne`, and
    # every floating-point one but a move names a type, as in `vadd.f32` or
    # `vcvt.s32.f32`.
    "arm": re.compile(
        r"[us]div(eq|ne|hs|cs|lo|cc|mi|pl|vs|vc|hi|ls|ge|lt|gt|le|al)?"
        r"|v(?!mov)\w+(\.\w+)*\.f(16|32|64)(\.\w+)*"
    ),
    # Scalar, LSX, and LASX division name their width, as in `div.du` or
    # `vmod.w`. Every floating-point mnemonic begins with `f`, or `vf` or
    # `xvf` for vectors; of them, moves, selects, loads, and stores take no
    # slow path.
    "loongarch64": re.compile(
        r"x?v?(div|mod)\.[bhwd]u?"
        r"|(x?v)?f(?!(mov\.|sel$|ldx?\.|stx?\.|ld[gl][te]\.|st[gl][te]\.))\w+(\.\w+)*"
    ),
    # Division names its width and may carry `e`, `u`, `o`, and a `.`, as in
    # `divwuo.`; `mod` its signedness and width. Scalar floating-point
    # mnemonics begin with `f`, of which only moves and sign changes take no
    # slow path; VSX scalar and vector arithmetic with `xs` and `xv`, apart
    # from its bitwise `xx`; and VMX floating point ends in `fp` or converts.
    "powerpc": re.compile(
        r"div[wd]e?u?o?\.?|mod[su][wd]"
        r"|f(?!(mr|abs|nabs|neg|cpsgn)\.?$)\w+\.?"
        r"|x[sv](?!(abs|nabs|neg|cpsgn)[sd]p$)\w+"
        r"|v\w+fp\.?|vc(fs|fu|ts|tu)x\w*|vrfi[nmpz]|v(div|mod)\w+"
    ),
    # Every floating-point mnemonic begins with `f`; of them, moves, loads,
    # stores, and the rounding mode and flags take no slow path, and `fence`
    # orders memory. riscv64gc has no vector extension.
    "riscv64": re.compile(
        r"(div|rem)u?w?"
        r"|f(?!(ence(\.\w+)?|mv\.\w+(\.\w+)?|l[hwdq]|s[hwdq]|[rs](csr|rm|flags)i?)$)\w+(\.\w+)*"
    ),
    # Scalar division, and z17's vector division and remainder. Binary
    # floating point names its format, `d`, `e`, or `x`, before a `b`, as in
    # `mdbr` or `cdlgbr`; vector floating point begins with `vf` or `wf`,
    # apart from the string searches `vfee`, `vfene`, and `vfae`, or
    # converts. LLVM emits no hexadecimal or decimal floating point.
    "s390x": re.compile(
        r"d|dr|dlg?r?|dsgf?r?|v[dr]l?[fgq]?"
        r"|(?![vw])\w*[dex]b(ra?)?|c[dex]l?[fg]bra?|cl?[fg][dex]bra?"
        r"|[vw]f(?!(ee|ene|ae)\w*$)\w+|[vw]c(dl?g|l?gd|el?f|l?fe)b?|[vw]l(ed|de)b?"
    ),
}

# Mnemonics each VARTIME pattern must refuse, then must allow, checked
# before every scan.
SAMPLES = {
    "x86": (
        "div idiv aam divsd vsqrtpd haddps addsubps vfmadd231pd vfmaddps vrcp14ps cvtsi2sd fdivp"
        " ucomisd vcmpltpd cmpss fsin fld fcomip",
        "mulx adcx vpmuludq vpaddd movaps xorps vpclmulqdq aesenc shrx cmp cmpxchg fnstcw fxsave64",
    ),
    "aarch64": (
        "udiv sdiv fdiv fsqrt faddp fmul fmla fcvtzs scvtf",
        "mul umulh fmov fcsel pmull aese eor3 lslv",
    ),
    "arm": (
        "udiv sdivne vdiv.f64 vsqrt.f32 vmul.f32 vfmane.f64 vcvt.s32.f32 vcvt.f32.u32",
        "umull umaal vmul.i32 vmull.p64 vmov.f32 vadd.i64 vld1.32 aese.8",
