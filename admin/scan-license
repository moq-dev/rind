#!/usr/bin/bash

set -e

bad=0
for f in $(find rind/src/ -name *.rs -exec grep -L "SPDX-License-Identifier:" {} +) ; do
  echo "$f requires a SPDX-License-Identifier"
  bad=1
done

# pyrind's wheels ship rind's code, so they carry rind's whole license.
if ! cmp -s rind/LICENSE rind-python/LICENSE; then
  echo "rind-python/LICENSE must be a copy of rind/LICENSE"
  bad=1
fi

exit $bad
