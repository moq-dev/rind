#!/bin/sh
set -e

# Usage: admin/ctgrind [unit|wycheproof|adapters|fips] [cargo test args...]
# Runs every suite but fips unless one is named, so CI can run them in
# parallel. fips checks the FIPS module, which refuses a CPU below its
# baseline, so the CPU-masked runs leave it out.
# Run it in `nix develop .#ctgrind`, which has the libclang and valgrind
# headers crabgrind builds with.
#
# Set `RUSTFLAGS='--cfg rind_portable --cfg curve25519_dalek_backend="serial"'`
# on x86_64 to check the portable backend, as `just portable` tests it.
#
# Pass `--target armv7-unknown-linux-gnueabihf` on a host that executes
# 32-bit ARM natively, such as an arm64 one, with an armhf valgrind.
# Valgrind passes `AT_HWCAP2` only to ppc64 programs (3.22 through 3.28), so
# the armv7 build never takes its ARMv8 crypto extension path here;
# `admin/ct-qemu` checks that under qemu-arm. It passes `AT_HWCAP`, so the
# NEON code is checked.
# See UPSTREAM.md, "Valgrind hides the ARM crypto extension and SHA3".
#
# Valgrind (through 3.27) decodes no AVX-512, VAES, VPCLMULQDQ, or SHA
# instruction and hides them from `cpuid`, so rind's AES-GCM on VAES, SHA-1
# and SHA-256 on the SHA extensions, SHA-384 and SHA-512 on the SHA512
# instructions, and AVX-512 ML-KEM and RSA go unchecked here. `admin/ct-sde` checks them under Intel SDE, all but ML-KEM, whose
# AVX-512 code samples only the public matrix.
# See UPSTREAM.md, "Valgrind cannot run x86_64's newest extensions".
#
# On aarch64 it hides SHA3, which rind takes for its eight-way AES-GCM
# kernels, SHA-384 and SHA-512 on the SHA-512 instructions, and its SHA3
# Keccak kernels, so `admin/ct-qemu --target aarch64-unknown-linux-gnu`
# checks those.
# See UPSTREAM.md, "Valgrind hides the ARM crypto extension and SHA3".
#
# Release builds keep line tables so memcheck names inlined frames, which
# the suppressions match.
self="$(cd "$(dirname "$0")" && pwd)/ctgrind"
valgrind="valgrind --error-exitcode=99 --suppressions=$(dirname "$self")/ctgrind.supp"

# Cargo runs each test binary through this script. `--track-origins=yes`
# roughly doubles memcheck's cost, so only a binary memcheck failed reruns
# with it, to name where each secret came from.
if [ "$1" = --run ]; then
    shift
    status=0
    $valgrind "$@" || status=$?
    if [ "$status" -eq 99 ]; then
        echo "ctgrind: memcheck failed; rerunning with --track-origins=yes" >&2
        $valgrind --track-origins=yes "$@" || true
    fi
    exit "$status"
fi

suite=all
case "$1" in
    unit | wycheproof | adapters | fips)
        suite=$1
        shift
        ;;
esac

# Valgrind runs ADX instructions but hides them from `cpuid`, so this switch
# makes rind check s2n-bignum's ADX routines rather than their `_alt` twins;
# deny `adx` with `RIND_CPU_DISABLE_adx`, building with
# `RUSTFLAGS='--cfg rind_cpu_disable'` for `--release`, for those.
# See UPSTREAM.md, "Valgrind hides ADX from `cpuid`".
export VALGRIND_BUG_494162=1
export CARGO_PROFILE_RELEASE_DEBUG=line-tables-only

export CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUNNER="$self --run"
export CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_RUNNER="$self --run"
export CARGO_TARGET_ARMV7_UNKNOWN_LINUX_GNUEABIHF_RUNNER="$self --run"

# rind's unit tests mark its secrets through the `__ctgrind` hooks. Wycheproof
# runs without them, since its harness compares secret outputs directly.
if [ "$suite" = all ] || [ "$suite" = unit ]; then
    cargo test -p rind --lib --features __ctgrind "$@"
fi
if [ "$suite" = all ] || [ "$suite" = wycheproof ]; then
    cargo test -p rind --test wycheproof "$@"
fi

# Each adapter's ctgrind test marks the secrets it hands rind, while rind's
# hooks mark the keys rind generates or parses. Python's tests run through
# its extension, not a Rust lib test binary, which would need libpython.
if [ "$suite" = all ] || [ "$suite" = adapters ]; then
    cargo test --workspace --exclude rind --exclude rind-python --exclude rind-fips --lib --test ctgrind --features rind/__ctgrind "$@"
fi

# The FIPS module as it ships, built with rind's hooks: its test marks the
# secrets it hands the module.
if [ "$suite" = fips ]; then
    cargo test -p rind-fips --test ctgrind --features __ctgrind,rind/__ctgrind "$@"
fi
