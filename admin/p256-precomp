#!/usr/bin/env python3
#
# Writes rind/src/mid/p256/precomp.rs, the P-256 generator tables, from
# Python's integers rather than rind's arithmetic, which the
# `p256::tests::base_point_precomp` test then checks them against.
#
# Row j of a table with window w holds i * 2^(w * j) * G for i in
# 1..=2^(w - 1), as affine points with Montgomery coordinates below P, each 4
# little-endian 64-bit words: on x86_64, the layout aws-lc's
# `ecp_nistz256_point_mul_base` reads with w = 7, and elsewhere, the one
# s2n-bignum's `p256_scalarmulbase` reads with a block size of 6.
#
# The 6-bit table is exactly the `p256_tabulates G 6` that s2n-bignum's proof
# of `p256_scalarmulbase_alt` assumes (arm/proofs/p256_scalarmulbase_alt.ml),
# with P and G HOL Light's `p_256` and `G_256` (EC/nistp256.ml), so that proof
# covers rind's aarch64 base-point multiplication, and
# `proofs/Rind/Aarch64/P256Table.lean` proves the table is.

import pathlib

P = 2**256 - 2**224 + 2**192 + 2**96 - 1
GX = 0x6B17D1F2E12C4247F8BCE6E563A440F277037D812DEB33A0F4A13945D898C296
GY = 0x4FE342E2FE1A7F9B8EE7EB4A7C0F9E162BCE33576B315ECECBB6406837BF51F5


def add(p1, p2):
    # Affine addition. No multiple in the tables is 0 mod the prime group
    # order, so no sum reaches infinity, which would raise: 0 has no inverse.
    (x1, y1), (x2, y2) = p1, p2
    if p1 == p2:
        m = (3 * x1 * x1 - 3) * pow(2 * y1, -1, P)
    else:
        m = (y2 - y1) * pow(x2 - x1, -1, P)
    x3 = (m * m - x1 - x2) % P
    return x3, (m * (x1 - x3) - y1) % P


def words(v):
    v = (v << 256) % P
    return [(v >> (64 * i)) & (2**64 - 1) for i in range(4)]


def table(cfg, window, row_type):
    # Booth recoding carries into a window above the top bit.
    rows, points = 256 // window + 1, 2 ** (window - 1)
    out = []
    base = (GX, GY)
    # Each row is its own constant, which Aeneas translates to its own Lean
    # definition: Lean cannot elaborate the whole table as one literal.
    for j in range(rows):
        out.append(f"#[cfg({cfg})]")
        out.append(f"/// 1G..{points}G << {window * j}")
        out.append(f"const ROW_{j}: {row_type} = [")
        point = base
        for i in range(1, points + 1):
            for coord in point:
                out.extend(f"    0x{w:016x}," for w in words(coord))
            if i < points:
                point = add(point, base)
        out.append("];")
        out.append("")
        for _ in range(window):
            base = add(base, base)
    out.append(f"#[cfg({cfg})]")
    out.append("pub(super) static CURVE_GENERATOR_PRECOMP: super::AffineMontPointTable = [")
    # Packed as rustfmt packs them.
    line = "   "
    for j in range(rows):
        item = f" ROW_{j},"
        if len(line) + len(item) > 100:
            out.append(line)
            line = "   "
        line += item
    out.append(line)
    out.append("];")
    return out


out = [
    "// This file is generated by `admin/p256-precomp`; do not edit.",
    "// SPDX-License-Identifier: Apache-2.0 OR ISC OR MIT-0",
    "",
    *table('rind_backend = "x86_64"', 7, "[u64; 512]"),
    "",
    *table('not(rind_backend = "x86_64")', 6, "[u64; 256]"),
]

path = pathlib.Path(__file__).resolve().parent.parent / "rind/src/mid/p256/precomp.rs"
# Renamed into place, so a failure partway leaves the committed file whole.
tmp = path.with_name(path.name + ".tmp")
tmp.write_text("\n".join(out) + "\n")
tmp.replace(path)
