#!/usr/bin/env bash
# Copy aws-lc's and BoringSSL's vector files that rind's tests run, RFC
# 9180's HPKE, RFC 9380's hash-to-curve, RFC 9474's blind RSA, and RFC 9497's
# OPRF vectors, into thirdparty/vectors, from the revisions pinned here. Both repositories are
# hundreds of megabytes, so rind keeps copies of the files rather than
# submodules. Bump a revision and rerun to update them.
set -euo pipefail

AWS_LC=2f9a0e95cc2c29235d9b98db8cf86e22b271b35a
BORINGSSL=0131ae9d78e42fcc2c1811315e62410ad96d8230
# RFC 9180's repository. hpkewg/hpke's revision of it repeats these vectors
# unchanged.
HPKE=b1f7cb0cdeab6906c61b3d6574e8bdfdbe1cd3fb
# RFC 9380's repository, whose `poc/vectors` are its Appendix J and K.
HASH_TO_CURVE=664b13592116cecc9e52fb192dcde0ade36f904e
# blind-rsa-signatures 0.18.0, whose JSON holds all four of RFC 9474's
# vectors; the CFRG draft's repository holds stale ones.
BLIND_RSA=45d0abfa829c3623389daae30bc35e9b2f3b550c
# RFC 9497's repository, whose `poc/vectors/allVectors.json` is its Appendix A.
VOPRF=5d7d94c8dc7589dc3baa116c1b9c169a7c33ac4e

# aws-lc's copy of each file BoringSSL also has holds every BoringSSL vector
# for rind's algorithms, so BoringSSL contributes only its own files.
aws_lc_files=(
    LICENSE
    crypto/cipher_extra/test/aes_128_gcm_tests.txt
    crypto/cipher_extra/test/aes_192_gcm_tests.txt
    crypto/cipher_extra/test/aes_256_gcm_tests.txt
    crypto/cipher_extra/test/chacha20_poly1305_tests.txt
    crypto/cipher_extra/test/cipher_tests.txt
    crypto/cipher_extra/test/xchacha20_poly1305_tests.txt
    crypto/ecdh_extra/ecdh_tests.txt
    crypto/evp_extra/evp_tests.txt
    crypto/fipsmodule/aes/aes_tests.txt
    crypto/fipsmodule/bn/test/miller_rabin_tests.txt
    crypto/fipsmodule/bn/test/mod_exp_tests.txt
    crypto/fipsmodule/bn/test/mod_exp_x2_tests.txt
    crypto/fipsmodule/bn/test/mod_mul_tests.txt
    crypto/fipsmodule/curve25519/ed25519_tests.txt
    crypto/fipsmodule/ec/ec_scalar_base_mult_tests.txt
    crypto/fipsmodule/ec/p256-nistz_tests.txt
    crypto/fipsmodule/ecdsa/ecdsa_sign_tests.txt
    crypto/fipsmodule/ecdsa/ecdsa_verify_tests.txt
    crypto/fipsmodule/modes/gcm_tests.txt
    crypto/hmac_extra/hmac_tests.txt
    crypto/poly1305/poly1305_tests.txt
)
boringssl_files=(
    LICENSE
    crypto/evp/test/ec_tests.txt
    crypto/evp/test/ed25519_tests.txt
    crypto/evp/test/mlkem_tests.txt
    crypto/evp/test/rsa_tests.txt
    crypto/evp/test/x25519_tests.txt
    crypto/mlkem/mlkem1024_decap_tests.txt
    crypto/mlkem/mlkem1024_encap_tests.txt
    crypto/mlkem/mlkem1024_keygen_tests.txt
    crypto/mlkem/mlkem1024_nist_decap_tests.txt
    crypto/mlkem/mlkem1024_nist_keygen_tests.txt
    crypto/mlkem/mlkem768_decap_tests.txt
    crypto/mlkem/mlkem768_encap_tests.txt
    crypto/mlkem/mlkem768_keygen_tests.txt
    crypto/mlkem/mlkem768_nist_decap_tests.txt
    crypto/mlkem/mlkem768_nist_keygen_tests.txt
)

cd "$(dirname "${BASH_SOURCE[0]}")/../thirdparty/vectors"

fetch() {
    local repo=$1 rev=$2 dir=$3
    shift 3
    rm -rf "$dir"
    for file in "$@"; do
        mkdir -p "$dir/$(dirname "$file")"
        curl --fail --silent --show-error --location --output "$dir/$file" \
            "https://raw.githubusercontent.com/$repo/$rev/$file"
    done
}

fetch aws/aws-lc "$AWS_LC" aws-lc "${aws_lc_files[@]}"
fetch google/boringssl "$BORINGSSL" boringssl "${boringssl_files[@]}"

# The 5.9 MB file holds every mode; rind keeps base mode, one vector per
# line, short of X448 (KEM 0x0021), which it does not offer.
rm -rf rfc9180
mkdir rfc9180
curl --fail --silent --show-error --location \
    "https://raw.githubusercontent.com/cfrg/draft-irtf-cfrg-hpke/$HPKE/test-vectors.json" |
    jq -c '.[] | select(.mode == 0 and .kem_id != 33)' >rfc9180/test-vectors.json

# The suites rind offers and the expand_message_xmd vectors, renamed without
# the colons Windows cannot check out.
rm -rf rfc9380
mkdir rfc9380
for file in P256_XMD:SHA-256_SSWU_RO_ P384_XMD:SHA-384_SSWU_RO_ P521_XMD:SHA-512_SSWU_RO_ \
    expand_message_xmd_SHA256_38 expand_message_xmd_SHA256_256 expand_message_xmd_SHA512_38; do
    curl --fail --silent --show-error --location --output "rfc9380/${file//:/_}.json" \
        "https://raw.githubusercontent.com/cfrg/draft-irtf-cfrg-hash-to-curve/$HASH_TO_CURVE/poc/vectors/$file.json"
done

rm -rf rfc9474
mkdir rfc9474
curl --fail --silent --show-error --location --output rfc9474/test-vectors.json \
    "https://raw.githubusercontent.com/jedisct1/rust-blind-rsa-signatures/$BLIND_RSA/tests/test_vectors_rfc9474.json"

# The OPRF and VOPRF modes of the suites rind offers, short of decaf448 and
# the POPRF mode.
rm -rf rfc9497
mkdir rfc9497
curl --fail --silent --show-error --location \
    "https://raw.githubusercontent.com/cfrg/draft-irtf-cfrg-voprf/$VOPRF/poc/vectors/allVectors.json" |
    jq '[.[] | select(.mode != 2 and .identifier != "decaf448-SHAKE256")]' >rfc9497/allVectors.json
