cd "$(dirname "${BASH_SOURCE[0]}")/../thirdparty/vectors"

# Each refresh writes into `<dir>.new` and swaps it in only once every file
# arrived, so a failed one leaves the committed copy whole.
stage() {
    rm -rf "$1.new"
    mkdir "$1.new"
}
swap() {
    rm -rf "$1"
    mv "$1.new" "$1"
}

fetch() {
    local repo=$1 rev=$2 dir=$3
    shift 3
    stage "$dir"
    for file in "$@"; do
        mkdir -p "$dir.new/$(dirname "$file")"
        curl --fail --silent --show-error --location --output "$dir.new/$file" \
            "https://raw.githubusercontent.com/$repo/$rev/$file"
    done
    echo "https://github.com/$repo/tree/$rev" >"$dir.new/REVISION"
    swap "$dir"
}

fetch aws/aws-lc "$AWS_LC" aws-lc "${aws_lc_files[@]}"
fetch google/boringssl "$BORINGSSL" boringssl "${boringssl_files[@]}"
fetch C2SP/wycheproof "$WYCHEPROOF" wycheproof "${wycheproof_files[@]}"
fetch ctz/cavp "$CAVP" cavp "${cavp_files[@]}"
fetch C2SP/CCTV "$CCTV" cctv "${cctv_files[@]}"

# The 5.9 MB file holds every mode; rind keeps base mode, one vector per
# line, short of X448 (KEM 0x0021), which it does not offer.
stage rfc9180
curl --fail --silent --show-error --location \
    "https://raw.githubusercontent.com/cfrg/draft-irtf-cfrg-hpke/$HPKE/test-vectors.json" |
    jq -c '.[] | select(.mode == 0 and .kem_id != 33)' >rfc9180.new/test-vectors.json
swap rfc9180

# The suites rind offers and the expand_message_xmd vectors, renamed without
# the colons Windows cannot check out.
stage rfc9380
for file in P256_XMD:SHA-256_SSWU_RO_ P384_XMD:SHA-384_SSWU_RO_ P521_XMD:SHA-512_SSWU_RO_ \
    expand_message_xmd_SHA256_38 expand_message_xmd_SHA256_256 expand_message_xmd_SHA512_38; do
    curl --fail --silent --show-error --location --output "rfc9380.new/${file//:/_}.json" \
        "https://raw.githubusercontent.com/cfrg/draft-irtf-cfrg-hash-to-curve/$HASH_TO_CURVE/poc/vectors/$file.json"
done
swap rfc9380

stage rfc9474
curl --fail --silent --show-error --location --output rfc9474.new/test-vectors.json \
    "https://raw.githubusercontent.com/jedisct1/rust-blind-rsa-signatures/$BLIND_RSA/tests/test_vectors_rfc9474.json"
swap rfc9474

# The OPRF and VOPRF modes of the suites rind offers, short of decaf448 and
# the POPRF mode.
stage rfc9497
curl --fail --silent --show-error --location \
    "https://raw.githubusercontent.com/cfrg/draft-irtf-cfrg-voprf/$VOPRF/poc/vectors/allVectors.json" |
    jq '[.[] | select(.mode != 2 and .identifier != "decaf448-SHAKE256")]' >rfc9497.new/allVectors.json
swap rfc9497
