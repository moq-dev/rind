#!/usr/bin/env python3
#
# Writes rind/src/mid/p521/precomp.rs, the P-521 generator table, from
# Python's integers rather than rind's arithmetic, which the
# `p521::tests::base_point_precomp_comb` test then checks it against.
#
# Table j holds i * 2^(20 * j) * G for i in 1..=16, as affine points, each
# coordinate 9 little-endian 64-bit words.

import pathlib

P = 2**521 - 1
GX = 0xC6858E06B70404E9CD9E3ECB662395B4429C648139053FB521F828AF606B4D3DBAA14B5E77EFE75928FE1DC127A2FFA8DE3348B3C1856A429BF97E7E31C2E5BD66
GY = 0x11839296A789A3BC0045C8A5FB42C7D1BD998F54449579B446817AFBD17273E662C97EE72995EF42640C550B9013FAD0761353C7086A272C24088BE94769FD16650

TABLES = 27
POINTS = 16


def add(p1, p2):
    # Affine addition; never reaches infinity, since the table only holds
    # multiples below the group order.
    (x1, y1), (x2, y2) = p1, p2
    if p1 == p2:
        m = (3 * x1 * x1 - 3) * pow(2 * y1, -1, P)
    else:
        m = (y2 - y1) * pow(x2 - x1, -1, P)
    x3 = (m * m - x1 - x2) % P
    return x3, (m * (x1 - x3) - y1) % P


def words(v):
    return [(v >> (64 * i)) & (2**64 - 1) for i in range(9)]


out = [
    "// This file is generated by `admin/p521-precomp`; do not edit.",
    "// SPDX-License-Identifier: Apache-2.0 OR ISC OR MIT-0",
    "",
    "pub(super) static CURVE_GENERATOR_PRECOMP_COMB: super::AffinePointTableComb = [",
]

base = (GX, GY)
for j in range(TABLES):
    out.append(f"    // 1G..{POINTS}G << {20 * j}")
    out.append("    [")
    point = base
    for i in range(1, POINTS + 1):
        for coord in point:
            out.extend(f"        0x{w:016x}," for w in words(coord))
        if i < POINTS:
            point = add(point, base)
    out.append("    ],")
    for _ in range(20):
        base = add(base, base)
out.append("];")

path = pathlib.Path(__file__).resolve().parent.parent / "rind/src/mid/p521/precomp.rs"
path.write_text("\n".join(out) + "\n")
