            "the fastest of aws-lc-rs and ring (aws-lc-rs alone where a feature is denied, since ring can't "
            "be denied one), in the row's benchmark where rind trails most. An empty cell runs the same code "
            "as the one to its left, so it isn't timed.",
            "",
            f"From [run {tiers['run']}]({tiers['url']}), {tiers['date'][:10]} at {commit_link(tiers['commit'])}, "
            f"on {', '.join(cpus)}.",
            "",
            *picture("tiers", "rind's time over the fastest of aws-lc-rs and ring, by CPU tier"),
            "",
            "<details>",
            "<summary>Every benchmark</summary>",
            "",
            *tier_table(tiers),
            "",
            "</details>",
            "",
        ]
        for theme, suffix in (("light", ""), ("dark", "-dark")):
            files[f"tiers{suffix}.svg"] = tiers_svg(tiers, theme)

    md += [
        "## Known gaps",
        "",
        "Each operation where another library is more than 10% faster than rind, on a host's native path or a "
        "CPU tier, and what is decided: a [speed](quest/m2/speed/README.md) quest that closes it, or the reason "
        "it stays. `benchmarks/gaps.toml` holds this table, and `admin/bench-report render` refuses a gap it "
        "lacks or an entry that is no longer a gap.",
        "",
        *(gap_table(gaps) if gaps else ["None."]),
        "",
        "## Verified code",
        "",
        "A ✓ means a published, machine-checked proof shows that all the code computing the operation, as "
        "that library runs it on that host, gives the specified result for every input: the cipher and its "
        "mode, the hash over every block with its padding, the whole scalar multiplication or exponentiation, "
        "and the glue around them, such as clamping, byte conversion, and point encoding. Parsing DER key and "
        "signature containers, randomness, and the message hash a signature takes are left out. Proofs of "
        "memory safety alone, or of only some of the code, earn no ✓. `benchmarks/verified.toml` holds this "
        "table.",
        "",
        "| Library | Operations | Platform | Proof |",
        "|---|---|---|---|",
    ]
    for e in verified:
        ops = ", ".join(f"`{p}`" for p in e["operations"])
        md.append(f"| {COLUMNS[e['library']]} | {ops} | {platform_of(e)} | [{e['proof']}]({e['link']}) |")
    md.append("")
    files = {os.path.join(REPORT_DIR, k): v for k, v in files.items()}
    files[REPORT] = "\n".join(md)
    return files


def import_hosts(directory):
    """Copies a collection's measured hosts into the report's data."""
    os.makedirs(DATA_DIR, exist_ok=True)
    for name in HOSTS:
        path = os.path.join(directory, f"{name}.json")
        if not os.path.exists(path):
            continue
        with open(path) as f:
            host = json.load(f)
        if host["status"] != "ok":
            print(f"bench-report: {name}: not imported, {host['status']}: {host['reason']}", file=sys.stderr)
            continue
        shutil.copy(path, os.path.join(DATA_DIR, f"{name}.json"))


def render(args):
    if args.collection:
        import_hosts(args.collection)
    hosts = load_hosts(DATA_DIR)
    tiers_path = os.path.join(DATA_DIR, "tiers.json")
    tiers = None
    if os.path.exists(tiers_path):
        with open(tiers_path) as f:
            tiers = json.load(f)
    verified = load_verified()
    generated = sorted(glob.glob(os.path.join(REPORT_DIR, "*.svg")))
    if os.path.exists(REPORT):
        generated.append(REPORT)
    if not hosts and tiers is None:
        if args.check and generated:
            fail("BENCHMARKS.md and its SVGs exist without results in benchmarks/data")
        if not args.check:
            fail("no results in benchmarks/data: run `collect`, then `render --from DIR`")
        return
    files = report(hosts, tiers, verified, load_gaps(hosts, tiers))
    if args.check:
        stale = [p for p in files if not os.path.exists(p) or open(p).read() != files[p]]
        stale += [p for p in generated if p not in files]
        if stale:
            fail("out of date, rerun `admin/bench-report render`: " + ", ".join(os.path.relpath(p, ROOT) for p in stale))
        return
    for path in generated:
        if path not in files:
            os.remove(path)
    os.makedirs(REPORT_DIR, exist_ok=True)
    for path, content in files.items():
        with open(path, "w") as f:
            f.write(content)
    print(os.path.relpath(REPORT, ROOT))


def significant(ns):
    return float(f"{ns:.4g}")


def nightly(args):
    """Saves the latest nightly bench's results on main as the CPU tiers,
    from a run that timed every tier, since the report reads an empty cell as
    code that tier shares with the one to its left."""
    runs = json.loads(
        output(
            ["gh", "run", "list", "--repo", REPO, "--workflow", "bench.yml", "--branch", "main", "--event"]
            + ["schedule", "--limit", "20", "--json", "databaseId,headSha,createdAt,url,status"]
        )
    )
    scratch = os.path.join(ROOT, ".tmp", "bench-report", "nightly")
    incomplete = []
    for run in runs:
        if run["status"] != "completed":
            continue
        shutil.rmtree(scratch, ignore_errors=True)
        got = subprocess.run(
            ["gh", "run", "download", str(run["databaseId"]), "--repo", REPO, "--pattern", "bench-*"]
            + ["--dir", scratch],
            capture_output=True,
        )
        paths = sorted(glob.glob(os.path.join(scratch, "*", "bench-results.json")))
        if got.returncode != 0 or not paths:
            continue
        tiers = []
        for path in paths:
            with open(path) as f:
                saved = json.load(f)
            benchmarks = {}
            for r in saved["results"]:
                parts = r["id"].split("/")
                lib = next((p for p in parts if p == "rind" or p in BASELINES), None)
                if lib is None:
                    continue
                key = "/".join("*" if p == lib else p for p in parts)
                benchmarks.setdefault(key, {})[lib] = significant(r["ns"])
            tiers.append({k: saved[k] for k in ("target", "portable", "tier", "cpu")} | {"benchmarks": benchmarks})
        order = {key: i for i, (key, _) in enumerate(TIERS)}
        missing = set(order) - {(t["target"], t["portable"], t["tier"]) for t in tiers}
        if missing:
            incomplete.append(f"{run['databaseId']} lacks {', '.join(dict(TIERS)[k] for k in sorted(missing))}")
            continue
        tiers.sort(key=lambda t: order.get((t["target"], t["portable"], t["tier"]), len(order)))
        os.makedirs(DATA_DIR, exist_ok=True)
        with open(os.path.join(DATA_DIR, "tiers.json"), "w") as f:
            json.dump(
                {
                    "schema": 1,
                    "run": run["databaseId"],
                    "url": run["url"],
                    "commit": run["headSha"],
                    "date": run["createdAt"],
                    "tiers": tiers,
                },
                f,
                indent=1,
            )
            f.write("\n")
        shutil.rmtree(scratch)
        print(f"bench-report: tiers from run {run['databaseId']}", file=sys.stderr)
        return
    fail("no completed nightly bench run on main timed every tier" + "".join(f"; run {r}" for r in incomplete))


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("collect", help="run the benchmarks on each host")
    p.add_argument("--commit", default="HEAD", help="the commit to measure (default HEAD)")
    p.add_argument("--host", action="append", help="a host to measure (default: all, in order)")
    p.add_argument("--out", help="the results directory (default .tmp/bench-report/<commit>)")
    p.set_defaults(func=collect)

    p = sub.add_parser("summary", help="print a collection's rind-versus-fastest table")
    p.add_argument("dir")
    p.set_defaults(func=summary)

    p = sub.add_parser("render", help="write BENCHMARKS.md and its SVGs from benchmarks/data")
    p.add_argument("--from", dest="collection", metavar="DIR", help="first import a collection's measured hosts")
    p.add_argument("--check", action="store_true", help="fail if BENCHMARKS.md or its SVGs are out of date")
    p.set_defaults(func=render)

    p = sub.add_parser("nightly", help="save the latest nightly bench's results as the CPU tiers")
    p.set_defaults(func=nightly)

    p = sub.add_parser("run", help="the host side of collect")
    p.add_argument("--host", required=True)
    p.add_argument("--commit", required=True)
    p.add_argument("--jobs", type=int, required=True)
    p.add_argument("--target-dir", required=True)
    p.add_argument("--out", required=True)
    p.set_defaults(func=run)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
