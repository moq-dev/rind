def fail(message):
    sys.exit(f"bench-report: {message}")


def operation_regex(refused=()):
    """A criterion filter matching exactly the report's operations, without
    the libraries in `refused`."""
    lib = "[^/]+"
    if refused:
        # The regex crate has no lookahead, so name the rest.
        lib = "(" + "|".join(re.escape(row) for row, name in LIBRARIES.items() if name not in refused) + ")"
    ops = "|".join(re.escape(op).replace(re.escape("{lib}"), lib) for op in OPERATIONS)
    return f"^({ops})$"


def operation_of(full_id):
    """The operation and library of a criterion ID, or None if it is not one."""
    for op in OPERATIONS:
        pattern = "^" + re.escape(op).replace(re.escape("{lib}"), "([^/]+)") + "$"
        m = re.match(pattern, full_id)
        if m:
            return op, m.group(1)
    return None


def pinned_toolchain():
    with open(os.path.join(ROOT, "flake.nix")) as f:
        m = re.search(r'rust-bin\.stable\."([0-9.]+)"', f.read())
    if not m:
        fail("flake.nix names no pinned stable toolchain")
    return m.group(1)


# --- host side --------------------------------------------------------------


def cpu_count():
    return os.cpu_count() or 1


def busy_limit():
    return max(1.0, BUSY_SHARE * cpu_count())


def cpu_times():
    """The system's (busy, total) CPU time in clock ticks."""
    if sys.platform == "darwin":
        # host_statistics(HOST_CPU_LOAD_INFO): user, system, idle, nice.
        libc = ctypes.CDLL(None)
        libc.mach_host_self.restype = ctypes.c_uint32
        ticks, count = (ctypes.c_uint32 * 4)(), ctypes.c_uint32(4)
        if libc.host_statistics(libc.mach_host_self(), 3, ticks, ctypes.byref(count)) != 0:
            fail("host_statistics failed")
        user, system, idle, nice = ticks
        return user + system + nice, user + system + idle + nice
    # The first eight fields, since user and nice already count guest time.
    with open("/proc/stat") as f:
        fields = [int(x) for x in f.readline().split()[1:9]]
    idle = fields[3] + fields[4]
    return sum(fields) - idle, sum(fields)


def busy_cpus_since(start):
    """How many logical CPUs were busy on average since `start`, a cpu_times()."""
    # macOS's counters are 32 bits, so they wrap after weeks of uptime.
    busy, total = ((now - then) % 2**32 for now, then in zip(cpu_times(), start))
    return busy / max(1, total) * cpu_count()


def busy_cpus(seconds=5):
    """How many logical CPUs other work keeps busy, averaged over `seconds`."""
    start = cpu_times()
    time.sleep(seconds)
    return busy_cpus_since(start)


def check_idle(when):
    busy = busy_cpus()
    if busy > busy_limit():
        raise Busy(f"{busy:.1f} of {cpu_count()} CPUs busy {when} (limit {busy_limit():.1f})")
    return round(busy, 2)


class Busy(Exception):
    pass


def output(cmd, env=None):
    return subprocess.run(cmd, capture_output=True, text=True, check=True, env=env).stdout.strip()


def cpu_model():
    if sys.platform == "darwin":
        return output(["sysctl", "-n", "machdep.cpu.brand_string"])
    with open("/proc/cpuinfo") as f:
        for line in f:
            if line.startswith(("model name", "Model")):
                return line.split(":", 1)[1].strip()
    return platform.processor()


def os_name():
    if sys.platform == "darwin":
        return f"macOS {platform.mac_ver()[0]} ({platform.release()})"
    pretty = platform.system()
    if os.path.exists("/etc/os-release"):
        with open("/etc/os-release") as f:
            for line in f:
                if line.startswith("PRETTY_NAME="):
                    pretty = line.split("=", 1)[1].strip().strip('"')
    return f"{pretty} (Linux {platform.release()})"


def locked_versions():
    """Each package's versions in Cargo.lock."""
    versions = {}
    with open(os.path.join(ROOT, "Cargo.lock")) as f:
        for name, version in re.findall(r'\[\[package\]\]\nname = "([^"]+)"\nversion = "([^"]+)"', f.read()):
            versions.setdefault(name, []).append(version)
    return versions


def toolchain(env):
    """The cargo command for the pinned toolchain, refusing any other."""
    if os.environ.get("IN_RIND_DEV_SHELL") != "1":
        fail("run inside the dev shell: nix develop --command admin/bench-report run ...")
    version = output(["rustc", "-vV"], env)
    release = re.search(r"^release: (.+)$", version, re.M).group(1)
    if release != pinned_toolchain():
        fail(f"rustc {release} is not the pinned {pinned_toolchain()}")
    return ["cargo"], {"rustc": version.splitlines()[0], "cargo": output(["cargo", "-V"], env)}, "openssl"


def run(args):
    started = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")
    result = {
        "schema": 1,
        "host": args.host,
        "commit": args.commit,
        "started": started,
        "cpu": {"model": cpu_model(), "arch": platform.machine(), "logical_cpus": cpu_count()},
        "os": os_name(),
    }

    def finish(status, **fields):
        result.update(status=status, **fields)
        with open(args.out, "w") as f:
            json.dump(result, f, indent=1)
            f.write("\n")

    try:
        idle_before_build = check_idle("before the build")
    except Busy as e:
        finish("busy", reason=str(e))
        fail(f"{args.host}: {e}")

    env = dict(os.environ, CARGO_BUILD_JOBS=str(args.jobs), CARGO_TERM_COLOR="never")
    env["CARGO_TARGET_DIR"] = os.path.abspath(args.target_dir)
    cargo, versions, openssl = toolchain(env)
    result["toolchain"] = versions
    locked = locked_versions()
    result["libraries"] = {
        lib: {crate: ", ".join(locked.get(crate, ["?"])) for crate in crates} for lib, crates in CRATES.items()
    }
    # The OpenSSL the benchmarks link, beside its crates.
    result["libraries"]["openssl"]["linked"] = output([openssl, "version"], env)

    bench = cargo + ["bench", "-p", "rind-bench", "--features", "__bench_openssl"]
    subprocess.run(bench + ["--no-run"], env=env, check=True)
    # The CPU features rind reads, which pick its paths on this host.
    result["rind_cpu"] = json.loads(output(cargo + ["run", "-q", "--release", "-p", "rind-cpuid"], env))
    # Each library this CPU lacks a required feature for, with the features.
    cpuid = result["rind_cpu"]["cpuid"]
    result["refused"] = {
        lib: missing
        for lib, features in REQUIRED.items()
        if (missing := [f for f in features.get(host_arch(result), []) if not cpuid[f]])
    }

    try:
        idle_before_run = check_idle("before the benchmarks")
    except Busy as e:
        finish("busy", reason=str(e))
        fail(f"{args.host}: {e}")

    criterion_dir = os.path.join(env["CARGO_TARGET_DIR"], "criterion")
    shutil.rmtree(criterion_dir, ignore_errors=True)
    criterion_args = CRITERION_ARGS + [operation_regex(result["refused"])]
    wall0 = time.monotonic()
    ticks0 = cpu_times()
    ours0 = resource.getrusage(resource.RUSAGE_CHILDREN)
    subprocess.run(bench + ["--"] + criterion_args, env=env, check=True)
    ours1 = resource.getrusage(resource.RUSAGE_CHILDREN)
    wall = time.monotonic() - wall0

    # Other work during the run: the system's busy CPUs less the benchmarks'.
    ours = (ours1.ru_utime + ours1.ru_stime) - (ours0.ru_utime + ours0.ru_stime)
    other = round(max(0.0, busy_cpus_since(ticks0) - ours / wall), 2)
    load = {
        "limit_cpus": round(busy_limit(), 2),
        "busy_cpus_before_build": idle_before_build,
        "busy_cpus_before_run": idle_before_run,
        "other_busy_cpus_during_run": other,
        "noisy": other > busy_limit(),
    }

    results = []
    for path in sorted(glob.glob(os.path.join(criterion_dir, "**", "new", "benchmark.json"), recursive=True)):
        with open(path) as f:
            meta = json.load(f)
        found = operation_of(meta["full_id"])
        if found is None:
            continue
        op, lib = found
        with open(os.path.join(os.path.dirname(path), "estimates.json")) as f:
            estimates = json.load(f)
        estimate = estimates.get("slope") or estimates["mean"]
        results.append(
            {
                "operation": op,
                "library": LIBRARIES.get(lib, lib),
                "id": meta["full_id"],
                "ns": estimate["point_estimate"],
                "ns_low": estimate["confidence_interval"]["lower_bound"],
                "ns_high": estimate["confidence_interval"]["upper_bound"],
                "throughput": meta.get("throughput"),
            }
        )
    order = {op: i for i, op in enumerate(OPERATIONS)}
    results.sort(key=lambda r: (order[r["operation"]], r["library"]))
    finished = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")
    finish(
        "ok",
        finished=finished,
        criterion_args=criterion_args,
        load=load,
        results=results,
        build_cost=build_cost(env, args.jobs, result["refused"]),
    )


def build_cost(env, jobs, refused):
    """admin/build-cost's measurements on this host, after the benchmarks so
    that neither skews the other's times, without the builds of libraries in
    `refused`, whose binaries it runs."""
    env = dict(env, CARGO_BUILD_JOBS=str(jobs))
    started = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")
    builds = [b for b in BUILDS if b not in refused] if refused else []
    proc = subprocess.run(
        [sys.executable, os.path.join(ROOT, "admin", "build-cost"), *builds], env=env, capture_output=True, text=True
    )
    if proc.returncode != 0:
        lines = proc.stderr.strip().splitlines() or ["no output"]
        print(proc.stderr, file=sys.stderr)
        return {"status": "failed", "started": started, "reason": lines[-1]}
    return {"status": "ok", "started": started, **json.loads(proc.stdout)}


# --- collection -------------------------------------------------------------


def is_local(host):
    return host == socket.gethostname().split(".")[0]


def ssh(host):
    # ServerAlive ends a session whose link died, which would otherwise hang
    # collect.
    options = ["BatchMode=yes", "ConnectTimeout=10", "ServerAliveInterval=15", "ServerAliveCountMax=4"]
    return ["ssh", *(arg for o in options for arg in ("-o", o)), HOSTS[host].get("ssh", host)]


def on_host(host, script, **kwargs):
    """Runs a shell script on `host`, here or over ssh."""
    if is_local(host):
        return subprocess.run(["sh", "-c", script], **kwargs)
    return subprocess.run(ssh(host) + [script], **kwargs)


# The host script's exit status when another run holds the host's lease, and
# when it could not copy the commit.
LEASE_HELD = 73
COPY_FAILED = 74


def host_script(host, work, cmd):
    """The shell script that copies the commit from stdin into a directory of
    its own under `work`, runs `cmd` there with its output on stderr, prints
    the result, and removes the copy. On a leased host it holds the lease
    throughout, and removes all of `work` before letting go."""
    q = shlex.quote
    w = q(work)
    # `cmd` runs in a subshell, since `work` may be relative to the start.
    script = (
        f'mkdir -p {w} && src=$(mktemp -d {w}/src.XXXXXX) && tar -x -C "$src" || exit {COPY_FAILED}\n'
        f'(cd "$src" && {cmd}) </dev/null >&2\n'
        'cat "$src/result.json"; code=$?; rm -rf "$src"; exit $code\n'
    )
    if "lease" not in HOSTS[host]:
        return script
    # The script's processes inherit the descriptor holding the lock. Python
    # closes it in its own children, but subprocess.run kills its child when
    # Python fails, so no child outlives the lease.
    lock = f"exec 9>{q(HOSTS[host]['lease'])} && {{ flock -n -E {LEASE_HELD} 9 || exit; }}\n"
    return lock + f"trap 'rm -rf {w}' EXIT\n" + script


def collect_host(host, commit, out_dir):
    out = os.path.join(out_dir, f"{host}.json")
    work = os.path.join(ROOT, ".tmp", "bench-report", "host") if is_local(host) else REMOTE_DIR
    q = shlex.quote

    def record(status, reason):
        with open(out, "w") as f:
            json.dump({"schema": 1, "host": host, "commit": commit, "status": status, "reason": reason}, f, indent=1)
            f.write("\n")
        print(f"bench-report: {host}: {status}: {reason}", file=sys.stderr)

    probe = on_host(host, "true", capture_output=True, text=True)
    if probe.returncode != 0:
        return record("unreachable", probe.stderr.strip())

    # Each collection extracts its own copy of the commit, so another on the
    # same host cannot replace it mid-run; the build directory is shared.
    archive = subprocess.run(["git", "-C", ROOT, "archive", "--format=tar", commit], capture_output=True, check=True)
    cmd = (
        f'nix develop "path:$PWD" --command python3 admin/bench-report run '
        f"--host {q(host)} --commit {q(commit)} --jobs {HOSTS[host]['jobs']} "
        f"--target-dir ../target --out result.json"
    )
    # Holding the host keeps every other gated command, such as another
    # collection's run, off it until the benchmarks and build costs finish.
    # The gate is this checkout's quest, so a commit pinning an older one
    # still runs, in its own dev shell.
    with open(os.path.join(ROOT, "flake.lock")) as f:
        quest = json.load(f)["nodes"]["quest"]["locked"]
    cmd = f"nix shell github:{quest['owner']}/{quest['repo']}/{quest['rev']} --command quest gate --host {cmd}"
    if "lease" in HOSTS[host]:
        # Crate downloads too, so that removing the work directory leaves nothing.
        cmd = f'CARGO_HOME="$PWD/../cargo" {cmd}'
    # A macOS ssh session runs no login shell, which is what puts Nix on PATH.
    cmd = f'export PATH="$PATH:/nix/var/nix/profiles/default/bin" && {cmd}'
    ran = on_host(host, host_script(host, work, cmd), input=archive.stdout, stdout=subprocess.PIPE)
    if ran.returncode == LEASE_HELD:
        return record("busy", "another run holds its lease")
    if ran.returncode == COPY_FAILED:
        return record("failed", "could not copy the commit")
    if ran.returncode != 0:
        return record("failed", "the run wrote no result; see its output above")
    with open(out, "wb") as f:
        f.write(ran.stdout)
    status = json.loads(ran.stdout)["status"]
    print(f"bench-report: {host}: {status}", file=sys.stderr)


def collect(args):
    # A gate nested in a gated command runs at once, so this host's run would
    # not hold the host.
    if os.environ.get("QUEST_GATE_ADMITTED") == "1":
        fail("run collect outside quest gate: it holds each host itself")
    commit = output(["git", "-C", ROOT, "rev-parse", f"{args.commit}^{{commit}}"])
    hosts = args.host or list(HOSTS)
    for host in hosts:
        if host not in HOSTS:
            fail(f"unknown host {host}; known: {', '.join(HOSTS)}")
    out_dir = args.out or os.path.join(ROOT, ".tmp", "bench-report", commit[:12])
    os.makedirs(out_dir, exist_ok=True)
    # One host at a time, so no run shares a machine or a network with another.
    for host in hosts:
        collect_host(host, commit, out_dir)
    print(out_dir)


def human(ns):
    if ns < 1e3:
        return f"{ns:.0f} ns"
    if ns < 1e6:
        return f"{ns / 1e3:.2f} µs"
    return f"{ns / 1e6:.2f} ms"


def summary(args):
    hosts = []
    for host in HOSTS:
        path = os.path.join(args.dir, f"{host}.json")
        if os.path.exists(path):
