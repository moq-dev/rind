def host_arch(host):
    arch = host["cpu"]["arch"]
    return {"arm64": "aarch64", "amd64": "x86_64"}.get(arch, arch)


def host_os(host):
    return "macos" if host["os"].startswith("macOS") else "linux"


def load_verified(path=VERIFIED):
    """The table of verified code, refusing an entry that names nothing."""
    with open(path, "rb") as f:
        entries = tomllib.load(f).get("verified", [])
    rows = [row_name(op) for op in OPERATIONS]
    required = {"library", "operations", "proof", "link"}
    optional = {"arch", "cpu", "os"}
    for i, e in enumerate(entries, 1):
        where = f"{os.path.relpath(path, ROOT)}: entry {i}"
        if set(e) - required - optional:
            fail(f"{where}: unknown keys {', '.join(sorted(set(e) - required - optional))}")
        if required - set(e):
            fail(f"{where}: missing {', '.join(sorted(required - set(e)))}")
        if e["library"] not in COLUMNS:
            fail(f"{where}: unknown library {e['library']}")
        if e.get("arch", "x86_64") not in CPU_FEATURES:
            fail(f"{where}: unknown arch {e['arch']}")
        if "cpu" in e and "arch" not in e:
            fail(f"{where}: CPU features need an arch")
        for feature in e.get("cpu", []):
            if feature.removeprefix("!") not in CPU_FEATURES[e["arch"]]:
                fail(f"{where}: unknown {e['arch']} CPU feature {feature}")
        if e.get("os", "linux") not in ("linux", "macos"):
            fail(f"{where}: unknown os {e['os']}")
        for pattern in e["operations"]:
            if not fnmatch.filter(rows, pattern):
                fail(f"{where}: {pattern} names no operation")
        if not e["link"].startswith("https://"):
            fail(f"{where}: the link is not https")
    return entries


def proof_for(verified, library, row, host):
    """The entry that verifies a library's code for an operation on a host."""
    cpuid = host.get("rind_cpu", {}).get("cpuid", {})
    for e in verified:
        if e["library"] != library or e.get("arch", host_arch(host)) != host_arch(host):
            continue
        if e.get("os", host_os(host)) != host_os(host):
            continue
        if not all(cpuid.get(f.removeprefix("!")) == (0 if f.startswith("!") else 1) for f in e.get("cpu", [])):
            continue
        if any(fnmatch.fnmatchcase(row, p) for p in e["operations"]):
            return e
    return None


