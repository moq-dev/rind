def header_lines(name):
    """A column header's lines, breaking before a + or a parenthesis."""
    return re.split(r" (?=[+(])", name)


def header_width(names):
    """The widest line of any column header."""
    return max((text_width(line, 12) for name in names for line in header_lines(name)), default=0)


def column_headers(svg, x0, y, cell_width, names):
    for i, name in enumerate(names):
        cx = x0 + i * cell_width + cell_width / 2
        lines = header_lines(name)
        for j, line in enumerate(lines):
            svg.text(cx, y - 14 * (len(lines) - 1 - j), line, anchor="middle", weight="bold")


def overview_svg(hosts, verified, theme):
    """Operations by library, each cell a square per host, colored by its time
    over the fastest library's on that host."""
    svg = Svg(theme)
    shown = [name for name in HOSTS if name in hosts]
    libs_shown = columns(*hosts.values())
    names = [COLUMNS[lib] for lib in libs_shown]
    squares = len(shown) * SQUARE + (len(shown) - 1) * GAP
    cell = max(squares + 18, header_width(names) + 12)
    label_width, top = grid_layout()
    host_times = {name: times(h) for name, h in hosts.items()}

    x = speed_legend(svg, 12, 18, [("✓", "verified code")])
    width = max(x, label_width + cell * len(names) + 12)
    svg.text(12, 38, "Each cell's squares, left to right: " + ", ".join(shown) + ".", size=11, color="muted")
    column_headers(svg, label_width, top, cell, names)

    y = top + 8
    for section, ops in SECTIONS:
        y += SECTION
        svg.text(12, y - 8, section, weight="bold")
        svg.line(12, y - 4, width - 12, y - 4)
        for op in ops:
            row = row_name(op)
            svg.text(12, y + 14, label(row))
            for c, lib in enumerate(libs_shown):
                x = label_width + c * cell + (cell - squares) / 2
                for h, name in enumerate(shown):
                    sx = x + h * (SQUARE + GAP)
                    libs = host_times[name].get(row, {})
                    if lib not in libs:
                        continue
                    ratio = libs[lib] / libs[fastest(libs)]
                    fill = svg.theme["speed"][bin_of(ratio, SPEED_BINS)]
                    proof = proof_for(verified, VARIANTS.get(lib, lib), row, hosts[name])
                    title = f"{label(row)}, {COLUMNS[lib]} on {name}: {human(libs[lib])}, {ratio:.2f}× the fastest"
                    if proof:
                        title += f"; verified: {proof['proof']}"
                    svg.rect(sx, y + 3, SQUARE, SQUARE, fill, title)
                    if proof:
                        svg.text(sx + SQUARE / 2, y + 14, "✓", size=10, anchor="middle", weight="bold", color=ink_on(fill))
            y += ROW
    return svg.render(width, y + 12, "Time over the fastest library's, by operation, library, and host")


def host_svg(name, host, verified, theme):
    """One host's times by operation and library, colored by each over the
    fastest library's."""
    svg = Svg(theme)
    cell = 92
    libs_shown = columns(host)
    label_width, top = grid_layout()
    width = label_width + cell * len(libs_shown) + 12
    x = speed_legend(svg, 12, 18, [("✓", "verified code")])
    width = max(width, x)
    svg.text(12, 38, f"{name}: {host['cpu']['model']}", size=11, color="muted")
    column_headers(svg, label_width, top, cell, [COLUMNS[lib] for lib in libs_shown])
    host_times = times(host)

    y = top + 8
    for section, ops in SECTIONS:
        y += SECTION
        svg.text(12, y - 8, section, weight="bold")
        svg.line(12, y - 4, width - 12, y - 4)
        for op in ops:
            row = row_name(op)
            libs = host_times.get(row, {})
            svg.text(12, y + 14, label(row))
            for c, lib in enumerate(libs_shown):
                x = label_width + c * cell + 2
                if lib not in libs:
                    continue
                ratio = libs[lib] / libs[fastest(libs)]
                fill = svg.theme["speed"][bin_of(ratio, SPEED_BINS)]
                proof = proof_for(verified, VARIANTS.get(lib, lib), row, host)
                title = f"{label(row)}, {COLUMNS[lib]}: {human(libs[lib])}, {ratio:.2f}× the fastest"
                if proof:
                    title += f"; verified: {proof['proof']}"
                svg.rect(x, y + 1, cell - 4, ROW - 2, fill, title)
                text = human(libs[lib]) + (" ✓" if proof else "")
                svg.text(x + (cell - 4) / 2, y + 14, text, size=11, anchor="middle", color=ink_on(fill))
