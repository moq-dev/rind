    return svg.render(width, y + 12, f"Times on {name}, by operation and library")


def tiers_svg(tiers, theme):
    """rind's time over the fastest baseline's per CPU tier, in the benchmark
    of each row where rind trails most."""
    svg = Svg(theme)
    cells = tier_cells(tiers)
    columns = tier_columns(tiers)
    cell = 74
    label_width = max(text_width(name, 12) for name, _ in TIER_ROWS) + 16
    top = 52
    width = label_width + cell * len(columns) + 12
    x = 12
    for i, name in enumerate(TIER_LABELS):
        svg.rect(x, 8, 12, 12, svg.theme["tier"][i])
        svg.text(x + 16, 18, name, size=11, color="muted")
        x += 16 + text_width(name, 11) + 12
    width = max(width, x)
    column_headers(svg, label_width, top, cell, columns)
    y = top + 10
    for row, _ in TIER_ROWS:
        svg.text(12, y + 14, row)
        for c, column in enumerate(columns):
            found = cells.get((row, column))
            if found is None:
                continue
            key, (ratio, rind, best, best_ns) = found
            fill = svg.theme["tier"][bin_of(ratio, TIER_BINS)]
            title = f"{row} on {column}: {key} takes {human(rind)} with rind, {human(best_ns)} with {best}"
            x = label_width + c * cell + 2
            svg.rect(x, y + 1, cell - 4, ROW - 2, fill, title)
            svg.text(x + (cell - 4) / 2, y + 14, f"{ratio:.2f}", size=11, anchor="middle", color=ink_on(fill))
        y += ROW
    return svg.render(width, y + 12, "rind's time over the fastest of aws-lc-rs and ring, by CPU tier")


def and_list(words):
    return words[0] if len(words) == 1 else ", ".join(words[:-1]) + ("," if len(words) > 2 else "") + " and " + words[-1]


def headline_rows(hosts):
    """Each headline row's label, each library's (host, time over rind's,
    time) on every host that timed both, and the build tools each needs."""
    rows = []
    for row in HEADLINE:
        per = {}
        for name in HOSTS:
            libs = times(hosts[name]).get(row, {}) if name in hosts else {}
            for lib in HEADLINE_LIBRARIES:
                if "rind" in libs and lib in libs:
                    per.setdefault(lib, []).append((name, libs[lib] / libs["rind"], human(libs[lib])))
        rows.append((label(row), per, {}))
    per, tools = {}, {}
    for name in HOSTS:
        cost = hosts.get(name, {}).get("build_cost") or {}
        builds = {b["name"]: b for b in cost.get("builds", [])} if cost.get("status") == "ok" else {}
        if HEADLINE_BUILDS["rind"] not in builds:
            continue
        rind = builds[HEADLINE_BUILDS["rind"]]["median_seconds"]
        for lib, build in HEADLINE_BUILDS.items():
            if build in builds:
                seconds = builds[build]["median_seconds"]
                per.setdefault(lib, []).append((name, seconds / rind, f"{seconds:.1f} s"))
                tools[lib] = builds[build]["tools"]
    rows.append(("cold build of a rustls client", per, tools))
    return [r for r in rows if "rind" in r[1]]


def headline_svg(hosts, theme):
    """The README's headline: each library's time over rind's for the
    HEADLINE operations and a rustls client's build, as the geometric mean
    over the hosts with a whisker across them."""
    svg = Svg(theme)
    rows = headline_rows(hosts)
    title = "Time over rind's for common TLS and QUIC operations and a rustls client's build"
    if not rows:
        svg.text(12, 18, "No host has timed the headline's operations yet.", color="muted")
        return svg.render(320, 28, title)
    timed = {host for _, per, _ in rows for found in per.values() for host, _, _ in found}
    shown = [name for name in HOSTS if name in timed]
    arches = sorted({host_arch(hosts[name]) for name in shown})
    bar_row, bar, bars = 16, 12, 300
    label_width = max(text_width(name, 12) for name, _, _ in rows) + 16
    name_width = max(text_width(COLUMNS[lib], 11) for lib in HEADLINE_LIBRARIES) + 10
    x0 = 12 + label_width + name_width
    width = x0 + bars + 130
    svg.text(12, 18, "Time over rind's: shorter is faster", size=13, weight="bold")
    svg.text(
        12,
        36,
        f"The geometric mean over {and_list(shown)} ({and_list(arches)}), with a whisker across them. "
        "BENCHMARKS.md has every time.",
        size=11,
        color="muted",
    )
    y = 52
    for name, per, tools in rows:
        top = max(r for found in per.values() for _, r, _ in found)
        svg.line(12, y, width - 12, y)
        y += 8
        svg.text(12, y + len(HEADLINE_LIBRARIES) * bar_row / 2 + 4, name)
        for i, lib in enumerate(HEADLINE_LIBRARIES):
            by = y + i * bar_row
            svg.text(12 + label_width, by + 11, COLUMNS[lib], size=11, color="muted")
            if lib not in per:
                svg.text(x0, by + 11, "not offered", size=11, color="muted")
                continue
            ratios = [r for _, r, _ in per[lib]]
            mean = math.exp(sum(math.log(r) for r in ratios) / len(ratios))
            tip = f"{name}, {COLUMNS[lib]}: " + "; ".join(
                f"{host} {value}, {r:.2f}× rind's" for host, r, value in per[lib]
            )
            fill = svg.theme["rind" if lib == "rind" else "other"]
            svg.rect(x0, by + (bar_row - bar) / 2, bars * mean / top, bar, fill, tip)
            lo, hi = x0 + bars * min(ratios) / top, x0 + bars * max(ratios) / top
            if hi - lo >= 1:
                mid = by + bar_row / 2
                svg.line(lo, mid, hi, mid, color="ink")
                svg.line(lo, mid - 3, lo, mid + 3, color="ink")
                svg.line(hi, mid - 3, hi, mid + 3, color="ink")
            text = "1×" if lib == "rind" else f"{mean:.2f}×"
            if tools.get(lib):
                text += ", needs " + ", ".join(tools[lib])
            svg.text(max(hi, x0 + bars * mean / top) + 6, by + 12, text, size=11)
        y += len(HEADLINE_LIBRARIES) * bar_row + 8
    return svg.render(width, y + 4, title)


# --- Markdown ---------------------------------------------------------------


def picture(name, alt):
    return [
        "<picture>",
        f'  <source media="(prefers-color-scheme: dark)" srcset="benchmarks/{name}-dark.svg">',
        f'  <img alt="{esc(alt)}" src="benchmarks/{name}.svg">',
        "</picture>",
    ]


def commit_link(commit):
    return f"[`{commit[:8]}`](https://github.com/{REPO}/commit/{commit})"


def measured(host):
    noisy = ", noisy" if host.get("load", {}).get("noisy") else ""
    return f"{host['started'][:10]} at {commit_link(host['commit'])}{noisy}"


def platform_of(entry):
    words = [entry.get("arch", "any architecture")]
    has = [f for f in entry.get("cpu", []) if not f.startswith("!")]
    lacks = [f.removeprefix("!") for f in entry.get("cpu", []) if f.startswith("!")]
    if has:
        words.append("with " + ", ".join(has))
    if lacks:
        words.append("without " + ", ".join(lacks))
    if "os" in entry:
        words.append({"linux": "on Linux", "macos": "on macOS"}[entry["os"]])
    return " ".join(words)


def host_table(host, verified):
    host_times = times(host)
    libs_shown = columns(host)
    lines = [
        "| Operation | " + " | ".join(COLUMNS[lib] for lib in libs_shown) + " |",
        "|---|" + "---|" * len(libs_shown),
    ]
    for op in OPERATIONS:
        row = row_name(op)
        libs = host_times.get(row, {})
        cells = []
        for lib in libs_shown:
            if lib not in libs:
                cells.append("-")
                continue
            check = " ✓" if proof_for(verified, VARIANTS.get(lib, lib), row, host) else ""
            cells.append(f"{human(libs[lib])}{check}")
        lines.append(f"| {label(row)} | " + " | ".join(cells) + " |")
    return lines


def build_table(cost):
    lines = [
        "| Build | Wall s (range) | CPU s | Stripped MB | Tools needed | Crates |",
        "|---|---|---|---|---|---|",
    ]
    for b in cost["builds"]:
        spread = f"{min(b['seconds']):.1f} to {max(b['seconds']):.1f}"
        lines.append(
            f"| {BUILDS.get(b['name'], b['name'])} | {b['median_seconds']:.1f} ({spread}) "
            f"| {b['median_cpu_seconds']:.0f} | {b['stripped_bytes'] / 1e6:.2f} "
            f"| {', '.join(b['tools']) or 'none'} | {len(b['packages'])} |"
        )
    return lines


def tier_table(tiers):
    columns = tier_columns(tiers)
    by_key = {}
    for t in tiers["tiers"]:
        column = dict(TIERS)[(t["target"], t["portable"], t["tier"])]
        for key, (ratio, *_) in tier_rows(t).items():
            by_key.setdefault(key, {})[column] = ratio
    lines = ["| Benchmark | " + " | ".join(columns) + " |", "|---|" + "---|" * len(columns)]
    for key in sorted(by_key):
        lines.append(
            f"| `{key}` | " + " | ".join(f"{by_key[key][c]:.2f}" if c in by_key[key] else "" for c in columns) + " |"
        )
    return lines


def report(hosts, tiers, verified, gaps):
    """BENCHMARKS.md, its SVGs, and the README's headline, by path."""
    files = {}
    shown = [name for name in HOSTS if name in hosts]
    missing = [f"`{name}`" for name in HOSTS if name not in hosts]
    words = ["no", "one", "two", "three", "four", "five", "six"]
    count = words[len(shown)] if len(shown) < len(words) else str(len(shown))
    md = [
        "# Benchmarks",
        "",
        "<!-- Generated by `admin/bench-report render` from benchmarks/data, benchmarks/verified.toml, and "
        "benchmarks/gaps.toml. -->",
        "",
        f"How long rind and the usual Rust crypto libraries take for the same operations, on {count} "
        f"machine{'' if len(shown) == 1 else 's'}, and what each costs to build. Every library runs its native "
        "path on each host. A ✓ marks an operation whose whole computation a published formal proof covers, as "
        "[Verified code](#verified-code) lists.",
        "",
        "## Hosts",
        "",
    ]
    if shown:
        md += ["| Host | CPU | OS | Measured |", "|---|---|---|---|"]
        md += [f"| `{n}` | {hosts[n]['cpu']['model']} | {hosts[n]['os']} | {measured(hosts[n])} |" for n in shown]
        md.append("")
    if missing:
        md += [f"Not measured yet: {', '.join(missing)}.", ""]
    md += [
        "Each host builds with the pinned toolchain in the Nix dev shell, and runs "
        "`admin/bench-report` only when idle. Times are criterion's estimates.",
        "",
    ]
    if shown:
        md += [
            "## Speed",
            "",
            "Each row is one operation and each column one library. Each cell holds a square per host, colored "
            "by that library's time over the fastest library's on the same host, as the legend shows. A ✓ in a "
            "square marks verified code. Each square's tooltip, in the SVG opened on its own, gives its time; "
            "the tables below each host give them all. A library with no square doesn't offer the operation, or "
            "the host didn't time it, as its section says.",
            "",
            *(
                [
                    "rind (DIT held) times rind with `rind::cpu::Dit::hold()` held across the timed loop, as a "
                    "caller batching calls does, so that DIT is set once rather than around each call. Only a CPU "
                    "with DIT times it, since elsewhere it runs the same code as rind's own column, and it never "
                    "counts as the fastest library.",
                    "",
                ]
                if "rind-dit-held" in columns(*hosts.values())
                else []
            ),
            *picture("overview", "Time over the fastest library's, by operation, library, and host"),
            "",
        ]
        for theme, suffix in (("light", ""), ("dark", "-dark")):
            files[f"overview{suffix}.svg"] = overview_svg(hosts, verified, theme)
            files[f"headline{suffix}.svg"] = headline_svg(hosts, theme)
    for name in HOSTS:
        if name not in hosts:
            continue
        h = hosts[name]
        untimed = [label(row_name(op)) for op in OPERATIONS if row_name(op) not in times(h)]
        md += [
            f"### `{name}`: {h['cpu']['model']}",
            "",
            f"Measured {measured(h)}, on {h['os']} with {h['toolchain']['rustc']}.",
            "",
            *([HOSTS[name]["note"], ""] if "note" in HOSTS[name] else []),
            *([f"Not timed on `{name}`: {', '.join(untimed)}.", ""] if untimed else []),
            *(
                f"{COLUMNS[lib]} isn't timed on `{name}`: it requires {and_list([f.upper() for f in missing])}, "
                "which this CPU lacks."
                for lib, missing in h.get("refused", {}).items()
            ),
            *([""] if h.get("refused") else []),
            *picture(name, f"Times on {name}"),
            "",
            "<details>",
            f"<summary>Times on {name}</summary>",
            "",
            *host_table(h, verified),
            "",
            "</details>",
            "",
        ]
        for theme, suffix in (("light", ""), ("dark", "-dark")):
            files[f"{name}{suffix}.svg"] = host_svg(name, h, verified, theme)

    if shown:
        md += [
            "## Build cost",
            "",
            "A cold `cargo build --release` of a minimal binary per library (AES-128-GCM, SHA-256, ECDSA P-256, "
            "and X25519) and of a rustls client per provider, plus one whose rind-rustls provider holds only "
            "those, by `admin/build-cost`: the median of three builds with an empty target directory and a warm "
            "download cache, their CPU time, the stripped binary's size, the build tools it needs beyond rustc "
            "and a linker, and the crates it compiles. The system OpenSSL build leaves the library itself out of "
            "its size; the vendored build is the static figure.",
            "",
        ]
    for name in shown:
        cost = hosts[name].get("build_cost")
        if not cost:
            continue
        md += [f"### `{name}`", ""]
        if cost["status"] != "ok":
            md += [f"Not measured: {cost['reason']}", ""]
            continue
        md += [
            f"Measured {cost['started'][:10]} at {commit_link(hosts[name]['commit'])}, "
            f"with {cost['host']['rustc']}, {cost['host']['cc']}, and {cost['host']['jobs']} jobs.",
            "",
            *build_table(cost),
            "",
        ]

    md += ["## CPU tiers", ""]
    if tiers is None:
        md += ["No nightly results yet.", ""]
    else:
        cpus = sorted({t["cpu"] for t in tiers["tiers"]})
        md += [
            "GitHub's runners, timed by the nightly `bench` workflow with CPU features denied as `bench.yml` "
            "describes: x86_64 runs every feature, and each column to its right denies more (no IFMA: AVX-512 "
            "IFMA; no ADX: also ADX; "
            "no AVX2: also AVX2, BMI2, SHA-NI, AVX-512, VAES, and VPCLMULQDQ; no AVX: also AVX; no AES-NI: "
            "also AES-NI, PCLMULQDQ, and SSE4.1; SSE2: also SSSE3). aarch64 runs with the crypto extension, "
