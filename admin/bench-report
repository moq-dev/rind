    out = {}
    for key, libs in tier["benchmarks"].items():
        base = {lib: ns for lib, ns in libs.items() if lib in BASELINES}
        if "rind" in libs and base:
            best = min(base, key=base.get)
            out[key] = (libs["rind"] / base[best], libs["rind"], best, base[best])
    return out


