    present = {tier_column(t) for t in tiers["tiers"]}
    return [name for _, name in TIERS if name in present]


def tier_row(key):
    """The CPU-tier row a nightly benchmark belongs to, if it is ranked."""
    return next((name for name, pattern in TIER_ROWS if re.match(pattern, key)), None)


def tier_cells(tiers):
    """Each CPU-tier row's worst benchmark per tier, as (key, ratio, ...)."""
    cells = {}
    for t in tiers["tiers"]:
        column = tier_column(t)
        for key, value in tier_rows(t).items():
            row = tier_row(key)
            if row is None:
                continue
            worst = cells.get((row, column))
            if worst is None or value[0] > worst[1][0]:
                cells[(row, column)] = (key, value)
    return cells


def gaps_of(hosts, tiers):
    """Each operation where another library beats rind by more than SLOWER, by
    (operation, host or tier), as (ratio, fastest library)."""
    out = {}
    for name, host in hosts.items():
        for row, libs in times(host).items():
            others = {lib: ns for lib, ns in libs.items() if lib != "rind" and lib not in VARIANTS}
            if "rind" in libs and others:
                best = min(others, key=others.get)
                if libs["rind"] / others[best] > SLOWER:
                    out[(row, name)] = (libs["rind"] / others[best], best)
    for t in tiers["tiers"] if tiers else []:
        column = tier_column(t)
        for key, (ratio, _, best, _) in tier_rows(t).items():
            if ratio > SLOWER and tier_row(key):
                out[(key, column)] = (ratio, best)
    return out


def load_gaps(hosts, tiers, path=GAPS):
    """The decision on each gap, with the gaps it covers, refusing a gap
    without one and an entry that names something other than a gap."""
    with open(path, "rb") as f:
        entries = tomllib.load(f).get("gap", [])
    found = gaps_of(hosts, tiers)
    out = []
    for i, e in enumerate(entries, 1):
        where = f"{os.path.relpath(path, ROOT)}: entry {i}"
        keys = {"operations", "on", "quest", "reason"}
        if set(e) - keys:
            fail(f"{where}: unknown keys {', '.join(sorted(set(e) - keys))}")
        if not {"operations", "on"} <= set(e):
            fail(f"{where}: needs operations and on")
        if ("quest" in e) == ("reason" in e):
            fail(f"{where}: needs a quest or a reason, not both")
        if "quest" in e and not (e["quest"].startswith("/quest/") and os.path.isfile(ROOT + e["quest"])):
            fail(f"{where}: no quest at {e['quest']}")
        covered = {}
        for op in e["operations"]:
            for place in e["on"]:
                if (op, place) not in found:
                    fail(f"{where}: {op} on {place} is no gap over 10%; update or remove the entry")
                covered[(op, place)] = found.pop((op, place))
        out.append((e, covered))
    if found:
        fail(
            f"gaps over 10% without a decision in {os.path.relpath(path, ROOT)}: "
            + ", ".join(f"{op} on {place} ({ratio:.2f}× {lib})" for (op, place), (ratio, lib) in sorted(found.items()))
        )
    return out


def quest_title(path):
    with open(ROOT + path) as f:
        return re.sub(r"^# (\[\w+\] )?", "", f.readline().strip())


def gap_table(gaps):
    rows = {row_name(op) for op in OPERATIONS}
    lines = ["| Operation | On | rind's time over the fastest | Decision |", "|---|---|---|---|"]
    for e, covered in gaps:
        ops = ", ".join(label(op) if op in rows else f"`{op}`" for op in e["operations"])
        on = ", ".join(f"`{p}`" if p in HOSTS else f"{p} tier" for p in e["on"])
        ratios = [ratio for ratio, _ in covered.values()]
        spread = f"{min(ratios):.2f}×" + (f" to {max(ratios):.2f}×" if max(ratios) - min(ratios) >= 0.005 else "")
        fastest = ", ".join(sorted({COLUMNS[lib] for _, lib in covered.values()}))
        decision = f"[{quest_title(e['quest'])}]({e['quest'][1:]})" if "quest" in e else e["reason"]
        lines.append(f"| {ops} | {on} | {spread} ({fastest}) | {decision} |")
    return lines


