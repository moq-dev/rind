def esc(text):
    return str(text).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace('"', "&quot;")


def text_width(text, size):
    # A sans-serif's average advance; layout only needs an upper bound.
    return len(text) * size * 0.6


def luminance(color):
    def channel(c):
        c = int(c, 16) / 255
        return c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4

    r, g, b = (channel(color[i : i + 2]) for i in (1, 3, 5))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def ink_on(fill):
    """Black or white, whichever contrasts more with the fill."""
    lum = luminance(fill)
    return "#0b0b0b" if (lum + 0.05) / 0.05 > 1.05 / (lum + 0.05) else "#ffffff"


class Svg:
    def __init__(self, theme):
        self.theme = THEMES[theme]
        self.items = []

    def text(self, x, y, text, size=12, anchor="start", weight="normal", color="ink"):
        fill = self.theme.get(color, color)
        self.items.append(
            f'<text x="{x:.1f}" y="{y:.1f}" font-size="{size}" text-anchor="{anchor}" '
            f'font-weight="{weight}" fill="{fill}">{esc(text)}</text>'
        )

    def rect(self, x, y, w, h, fill, title=None):
        attrs = f'x="{x:.1f}" y="{y:.1f}" width="{w:.1f}" height="{h:.1f}" rx="2" fill="{fill}"'
        if title:
            self.items.append(f"<rect {attrs}><title>{esc(title)}</title></rect>")
        else:
            self.items.append(f"<rect {attrs}/>")

    def line(self, x1, y1, x2, y2, color="rule"):
        self.items.append(
            f'<line x1="{x1:.1f}" y1="{y1:.1f}" x2="{x2:.1f}" y2="{y2:.1f}" stroke="{self.theme[color]}"/>'
        )

    def render(self, width, height, title):
        return "\n".join(
            [
                f'<svg xmlns="http://www.w3.org/2000/svg" width="{width:.0f}" height="{height:.0f}" '
                f'viewBox="0 0 {width:.0f} {height:.0f}" font-family="{esc(FONT)}" role="img">',
                f"<title>{esc(title)}</title>",
                *self.items,
                "</svg>",
                "",
            ]
        )


def speed_legend(svg, x, y, extra=()):
    """The speed bins' swatches in one row, then any (mark, meaning) pairs."""
    for i, name in enumerate(SPEED_LABELS):
        svg.rect(x, y - 10, 12, 12, svg.theme["speed"][i])
        svg.text(x + 16, y, name, size=11, color="muted")
        x += 16 + text_width(name, 11) + 12
    for mark, meaning in extra:
        svg.text(x, y, mark, size=12, weight="bold")
        svg.text(x + 14, y, meaning, size=11, color="muted")
        x += 14 + text_width(meaning, 11) + 12
    return x


