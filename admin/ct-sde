#!/usr/bin/env python3

# Usage: admin/ct-sde [filter]
#
# The constant-time check for code valgrind cannot run, such as AVX-512 and
# VAES (see `admin/ctgrind`). Each rind test named `ct_sde...` derives its
# secrets from a seed and marks the call it checks. This runs each one whose
# name contains `filter` twice under its Intel SDE CPU model, with different
# seeds, and fails unless SDE's debugtraces of the marked call name the same
# instruction and memory addresses in the same order. The traces stream
# through pipes and are compared as they arrive, so no run stores one. It
# cannot see variable-time instructions, which take the same addresses
# whatever their operands; `admin/ct-vartime` looks for those.
#
# The `ct_sde_planted_...` tests leak their seed, and run every time. They
# must differ, so a harness that traces nothing, or compares nothing, fails.
#
# Run it in `nix develop .#sde`. Without ASLR, as `setarch -R` runs it, the
# stack and heap lie at the same addresses for both seeds, so long as Pin,
# whose own mappings vary in size from run to run, keeps them out of the
# program's way.

import collections, itertools, json, os, re, subprocess, sys, tempfile

SEEDS = ["0123456789abcdef", "fedcba9876543210"]
# `rind/src/low/x86_64/ct_sde.rs` marks the call between these.
MARKS = ["52430001:repeat", "52430002:repeat"]
# The SDE CPU model for tests whose names contain each key, else Sapphire
# Rapids. Each test asserts that its model takes the path it checks.
MODELS = {
    "vaes_avx2": "-adl",  # Alder Lake: VAES without AVX-512.
    "hmac": "-arl",  # Arrow Lake: the SHA extensions and SHA512 instructions.
}
# Far below where the program maps its thread stacks and heaps.
PIN_MEMORY = "0x100000000000:0x200000000000"

# An instruction, without the registers it wrote, or a memory access,
# without its value.
INS = re.compile(r"INS (0x[0-9a-f]+) +\S+ +(.*?) *(\| .*)?$")
MEM = re.compile(r"(Read|Write) .*?\*\((.+?)\*\)(0x[0-9a-f]+)", re.S)


def records(trace):
    """Each of SDE's records, without its values: a vector's value
    continues onto lines that start with a tab."""
    record = None
    for line in trace:
        if line.startswith("\t") and record is not None:
            record += line
            continue
        if record is not None:
            yield normalize(record)
        record = line
    if record is not None:
        yield normalize(record)


def normalize(record):
    first = record.split("\n", 1)[0]
    if m := INS.match(first):
        return "INS {} {}".format(m[1], " ".join(m[2].split()))
    if m := MEM.match(record):
        return "{} *({}*){}".format(m[1], m[2], m[3])
    return first


def build():
    out = subprocess.run(
        ["cargo", "test", "-p", "rind", "--lib", "--release", "--no-run"]
        + ["--message-format=json-render-diagnostics"],
        stdout=subprocess.PIPE,
        check=True,
        encoding="utf-8",
    ).stdout
    for line in out.splitlines():
        js = json.loads(line)
        if js.get("reason") == "compiler-artifact" and js.get("executable"):
            if js["target"]["name"] == "rind":
                return js["executable"]
    sys.exit("ct-sde: no rind test binary")


def tests(exe, filter):
    out = subprocess.run(
        [exe, "--list", "--ignored", "--format", "terse"],
        stdout=subprocess.PIPE,
        check=True,
        encoding="utf-8",
    ).stdout
    names = [line.removesuffix(": test") for line in out.splitlines()]
    names = [n for n in names if n.split("::")[-1].startswith("ct_sde")]
    planted = [n for n in names if is_planted(n)]
    return planted + [n for n in names if filter in n and not is_planted(n)]


def is_planted(name):
    return name.split("::")[-1].startswith("ct_sde_planted")


def model(name):
    return next((m for key, m in MODELS.items() if key in name), "-spr")


def compare(exe, name, tmp):
    """Traces `name` once for each seed, and returns where the traces differ,
    with the lines before it, or None, and how many lines they agreed on."""
    procs = []
    files = []
    for i, seed in enumerate(SEEDS):
        # A pipe rather than a named one, so that if SDE fails, the trace
        # ends rather than waits for SDE to open it.
        r, w = os.pipe()
        cmd = ["setarch", "-R", "sde", model(name), "-p", "-pin_memory_range"]
        cmd += ["-p", PIN_MEMORY, "-debugtrace"]
        cmd += ["-dt_out", "/dev/fd/{}".format(w)]
        cmd += ["-start_ssc_mark", MARKS[0], "-stop_ssc_mark", MARKS[1], "--"]
        cmd += [exe, "--ignored", "--exact", name, "--test-threads=1", "-q"]
        env = dict(os.environ, RIND_CT_SDE_SEED=seed)
        log = open(os.path.join(tmp, "log{}".format(i)), "w+")
        # SDE writes its own logs to its working directory.
        proc = subprocess.Popen(
            cmd, env=env, cwd=tmp, stdout=log, stderr=log, pass_fds=[w]
        )
        os.close(w)
        procs.append((proc, log))
        files.append(open(r))

    traces = [records(f) for f in files]
    context = collections.deque(maxlen=8)
    lines = 0
    diff = None
    for a, b in itertools.zip_longest(*traces, fillvalue="(end)"):
        if a != b:
            diff = (context, a, b)
            break
        context.append(a)
        lines += 1

    for proc, log in procs:
        if diff:
            proc.kill()
        elif proc.wait() != 0:
            log.seek(0)
            sys.exit("ct-sde: {} failed under SDE:\n{}".format(name, log.read()))
    for f in files:
        f.close()
    for proc, _ in procs:
        proc.wait()
    return diff, lines


def main():
    # Each result as it comes, since a run takes about an hour.
    sys.stdout.reconfigure(line_buffering=True)
    filter = sys.argv[1] if len(sys.argv) > 1 else ""
    exe = build()
    names = tests(exe, filter)
    if all(is_planted(n) for n in names):
        sys.exit("ct-sde: no ct_sde test matches {!r}".format(filter))

    failed = False
    for name in names:
        with tempfile.TemporaryDirectory() as tmp:
            diff, lines = compare(exe, name, tmp)
        planted = is_planted(name)
        if lines == 0:
            print("FAIL {}: traced nothing".format(name))
            failed = True
        elif diff and not planted:
            context, a, b = diff
            print("FAIL {}: traces differ after {} lines".format(name, lines))
            for line in context:
                print("    " + line)
            print("  - " + a)
            print("  + " + b)
            failed = True
        elif not diff and planted:
            print("FAIL {}: a planted leak traced the same".format(name))
            failed = True
        else:
            print("ok   {}: {} lines".format(name, lines))
    sys.exit(failed)


main()
