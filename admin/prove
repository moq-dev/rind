    --opaque crate::low::x86_64::ghash::u128_to_m128i \
    --opaque crate::low::x86_64::ghash::GF128_POLY_HI \
    --opaque crate::low::x86_64::ghash::GF128_POLY_CARRY_MASK \
    --include crate::low::x86_64::aes_gcm::seal \
    --include crate::low::x86_64::aes_gcm::open \
