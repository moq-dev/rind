    --include crate::low::x86_64::aes_gcm::VAES_AVX2_VALE_SEAL_BELOW \
    --include crate::low::x86_64::aes_gcm_avx \
    --opaque crate::low::x86_64::aes_gcm_avx::counter_block \
    --opaque crate::low::x86_64::aes_gcm_avx::aead
extract aarch64 Aarch64 \
    --start-from crate::mid::p256::PrivateKey::from_bytes \
    --start-from crate::high::ecdsa::VerifyingKey::from_x962_uncompressed \
    --start-from crate::high::ecdsa::VerifyingKey::verify \
    --start-from crate::high::ecdsa::SigningKey::new \
    --start-from crate::high::ecdsa::SigningKey::generate \
    --start-from '{impl core::clone::Clone for crate::high::ecdsa::VerifyingKey<_>}' \
    --start-from '{impl core::clone::Clone for crate::mid::p256::VerifyingKey}' \
