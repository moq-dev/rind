for file in Dispatch X25519 DigestAlgorithm DigestDispatch Sha512 ChaCha20 SignatureDispatch Ed25519 \
    Blockwise Sha Hmac HashAxioms; do
    sed 's/X86_64/Aarch64/g; s/x86_64/aarch64/g' "proofs/Rind/X86_64/$file.lean" >"proofs/Rind/Aarch64/$file.lean"
done

[ "${PROVE_TRANSLATE_ONLY:-}" ] && exit 0
cd proofs
lake exe cache get
lake build
