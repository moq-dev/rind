    --opaque crate::aead::Ops \
    --start-from '{impl crate::aead::Cipher for crate::mid::chacha20poly1305::ChaCha20Poly1305}' \
    --opaque '{impl crate::aead::Cipher for crate::mid::chacha20poly1305::ChaCha20Poly1305}::_' \
    --include crate::mid::aes::expand_key \
    --include crate::mid::aes::check_gcm_lengths \
    --include crate::mid::aes::check_counter \
    --include crate::low::x86_64::aes \
    --opaque crate::low::x86_64::aes::aes128_expand \
    --opaque crate::low::x86_64::aes::aes192_expand \
    --opaque crate::low::x86_64::aes::aes256_expand \
    --opaque crate::low::x86_64::aes::aes128_block \
    --opaque crate::low::x86_64::aes::aes256_block \
